{
  "دالة": {
    "prefix": "دالة",
    "body": [
      "دالة ${1:الاسم}(${2:المعاملات}):",
      "\t${3:أعد ${4:القيمة}}"
    ],
    "description": "تعريف دالة جديدة"
  },
  "صنف": {
    "prefix": "صنف",
    "body": [
      "صنف ${1:الاسم}:",
      "\tدالة إنشاء(${2:المعاملات}):",
      "\t\t${3:هذا.خاصية = ${2:المعاملات}}"
    ],
    "description": "تعريف صنف مع منشئ"
  },
  "لو": {
    "prefix": "لو",
    "body": [
      "لو ${1:الشرط}:",
      "\t${2:افعل شيئًا}"
    ],
    "description": "جملة شرطية"
  },
  "لووإلا": {
    "prefix": "لووإلا",
    "body": [
      "لو ${1:الشرط}:",
      "\t${2:افعل شيئًا}",
      "وإلا إذا ${3:شرط آخر}:",
      "\t${4:افعل شيئًا آخر}",
      "وإلا:",
      "\t${5:البديل}"
    ],
    "description": "شرط متعدد الفروع"
  },
  "بدّل": {
    "prefix": "بدّل",
    "body": [
      "بدّل ${1:القيمة}",
      "حالة ${2:قيمة}:",
      "\t${3:افعل شيئًا}",
      "افتراض:",
      "\t${4:الحالة الافتراضية}"
    ],
    "description": "بدّل مع حالة وافتراض"
  },
  "طالما": {
    "prefix": "طالما",
    "body": [
      "طالما ${1:الشرط}:",
      "\t${2:افعل شيئًا}"
    ],
    "description": "حلقة طالما"
  },
  "لكل": {
    "prefix": "لكل",
    "body": [
      "لكل ${1:العنصر} في ${2:القائمة}:",
      "\t${3:افعل شيئًا}"
    ],
    "description": "حلقة لكل عنصر"
  },
  "جرب": {
    "prefix": "جرب",
    "body": [
      "جرب:",
      "\t${1:كود قد يخطئ}",
      "باستثناء:",
      "\t${2:معالجة الخطأ}"
    ],
    "description": "معالجة أخطاء"
  },
  "استورد": {
    "prefix": "استورد",
    "body": [
      "استورد ${1:الوحدة}"
    ],
    "description": "استيراد وحدة"
  },
  "منستورد": {
    "prefix": "منستورد",
    "body": [
      "من ${1:الوحدة} استورد ${2:الاسم}"
    ],
    "description": "استيراد أسماء محددة من وحدة"
  },
  "سهمية": {
    "prefix": "سهمية",
    "body": [
      "دالة(${1:المعاملات}) => ${2:التعبير}"
    ],
    "description": "دالة سهمية على سطر واحد"
  },
  "اطبع": {
    "prefix": "اطبع",
    "body": [
      "اطبع(${1:الرسالة})"
    ],
    "description": "طباعة إلى الشاشة"
  },
  "فنص": {
    "prefix": "فنص",
    "body": [
      "ق\"${1:نص} {${2:المتغير}}\""
    ],
    "description": "نص منسق مع حقن تعبير"
  },
  "خاصية محسوبة": {
    "prefix": "خاصية",
    "body": [
      "خاصية ${1:الاسم}:",
      "    أعد ${2:التعبير}"
    ],
    "description": "خاصية محسوبة داخل صنف"
  },
  "تعداد": {
    "prefix": "تعداد",
    "body": [
      "تعداد ${1:الاسم}:",
      "    ${2:عضو}",
      "    ${3:عضو_آخر}"
    ],
    "description": "تعريف تعداد"
  },
  "خطأ مخصص": {
    "prefix": "خطأ",
    "body": [
      "صنف ${1:خطأ_جديد} من استثناء:",
      "    تجاهل",
      "",
      "جرب:",
      "    ارفع ${1:خطأ_جديد}(\"${2:رسالة}\")",
      "باستثناء ${3:هـ}:",
      "    اطبع(${3:هـ}.رسالة)"
    ],
    "description": "صنف خطأ مخصص مع جرب/باستثناء"
  },
  "قواميس بمفاتيح بلا اقتباس": [
    {
      "prefix": "قاموس-سريع",
      "body": [
        "{${1:المفتاح}: ${2:القيمة}}"
      ],
      "description": "قاموس بمفاتيح بلا اقتباس (جديد في 1.6)"
    }
  ],
  "اختبار يساوي": [
    {
      "prefix": "اختبار-يساوي",
      "body": [
        "اختبارات.يساوي(${1:الفعلي}، ${2:المتوقع}، \"${3:اسم الاختبار}\")"
      ],
      "description": "اختبار مساواة بإطار الاختبارات (جديد في 1.6)"
    }
  ],
  "ملخص الاختبارات": [
    {
      "prefix": "اختبار-ملخص",
      "body": [
        "النتيجة = اختبارات.ملخص()",
        "اطبع(النتيجة[\"ناجح\"]، النتيجة[\"فاشل\"])"
      ],
      "description": "ملخص نتائج الاختبارات (جديد في 1.6)"
    }
  ],
  "خادم ويب": [
    {
      "prefix": "خادم",
      "body": [
        "استورد خادم",
        "",
        "دالة معالج(طلب):",
        "\tلو طلب[\"المسار\"] == \"/${1:/}\":",
        "\t\tأعد {الحالة: 200، النص: \"${2:مرحبا}\"}",
        "\tأعد {الحالة: 404، النص: \"غير موجودة\"}",
        "",
        "المنفذ = خادم.ابدأ(${3:8080}، معالج)",
        "خادم.انتظر()"
      ],
      "description": "خادم ويب كامل (جديد في 1.6)"
    }
  ],
  "نص منسق متعدد الأسطر": [
    {
      "prefix": "فنص-متعدد",
      "body": [
        "ق\"\"\"${1:سطر أول ${2:تعبير}}",
        "${3:سطر ثانٍ}\"\"\""
      ],
      "description": "نص منسق متعدد الأسطر (جديد في 1.6)"
    }
  ],
  "مولد": {
    "prefix": "فمولد",
    "body": [
      "دالة ${1:الاسم}():",
      "    ${2:لكل س في مدى(${3:10}):",
      "        }أنتج ${4:س}"
    ],
    "description": "مولد بكلمة أنتج (جديد في 1.7)"
  },
  "مزخرف": {
    "prefix": "فمزخرف",
    "body": [
      "دالة ${1:الاسم}(د):",
      "    دالة مغلفة(${2:س}):",
      "        ${3:# منطق ما قبل الاستدعاء}",
      "        النتيجة = د(${2:س})",
      "        ${4:# منطق ما بعد الاستدعاء}",
      "        أعد النتيجة",
      "    أعد مغلفة",
      "",
      "@${1:الاسم}",
      "دالة ${5:مزينة}(${2:س}):",
      "    ${6:أعد س}"
    ],
    "description": "مزخرف @ كامل (جديد في 1.7)"
  },
  "قاعدة بيانات": {
    "prefix": "فقاعدة",
    "body": [
      "استورد قاعدة",
      "",
      "ق = قاعدة.افتح(\"${1:قاعدة.db}\")",
      "ق.نفذ(\"CREATE TABLE ${2:جدول} (${3:الاسم TEXT, العمر INTEGER})\")",
      "ق.نفذ(\"INSERT INTO ${2:جدول} VALUES (?, ?)\", [${4:\"قيمة\"}, ${5:1}])",
      "لكل صف في ق.استعلم(\"SELECT * FROM ${2:جدول}\"):",
      "    اطبع(صف)",
      "ق.أغلق()"
    ],
    "description": "قاعدة بيانات SQLite (جديد في 1.7)"
  },
  "وراثة متعددة": {
    "prefix": "فصنف-متعدد",
    "body": [
      "صنف ${1:الابن} من ${2:الأول}، ${3:الثاني}:",
      "    دالة ${4:طريقة}():",
      "        أعد الأصل.${4:طريقة}()"
    ],
    "description": "صنف بوراثة متعددة (جديد في 1.7)"
  },
  "واجهة": {
    "prefix": "فواجهة",
    "body": [
      "واجهة ${1:الاسم}:",
      "    دالة ${2:الطريقة_المجردة}()",
      "",
      "صنف ${3:المنفذ} من ${1:الاسم}:",
      "    دالة ${2:الطريقة_المجردة}():",
      "        ${4:أعد القيمة}"
    ],
    "description": "واجهة + صنف منفذ (جديد في 1.8)"
  },
  "معامل متغير": {
    "prefix": "فمتغير",
    "body": [
      "دالة ${1:الاسم}(...${2:قيم}):",
      "    ${3:أعد طول(${2:قيم})}"
    ],
    "description": "دالة بمعامل متغير ... (جديد في 1.8)"
  },
  "تفكيك": {
    "prefix": "فتفكيك",
    "body": [
      "${1:الناتج} = ${2:الدالة}(...${3:القائمة})"
    ],
    "description": "تفكيك قائمة إلى وسائط (جديد في 1.8)"
  },
  "خيوط": {
    "prefix": "فخيوط",
    "body": [
      "دالة ${1:عمل}(${2:وسيطة}):",
      "    أعد ${3:الوسيطة * ٢}",
      "",
      "خ = خيوط.شغّل(${1:عمل}، ${4:٥})",
      "اطبع(خ.نتيجة())"
    ],
    "description": "تشغيل دالة في خيط (جديد في 1.8)"
  },
  "قفل": {
    "prefix": "فقفل",
    "body": [
      "${1:الحارس} = خيوط.قفل()",
      "${1:الحارس}.احجز()",
      "عالمي ${2:العداد}",
      "${2:العداد} += ١",
      "${1:الحارس}.افرح()"
    ],
    "description": "قفل لحماية بيانات مشتركة (جديد في 1.8)"
  }
}