{
  "دالة": {
    "prefix": "دالة",
    "body": [
      "دالة ${1:الاسم}(${2:المعاملات}):",
      "\t${3:أعد ${4:القيمة}}"
    ],
    "description": "تعريف دالة جديدة"
  },
  "صنف": {
    "prefix": "صنف",
    "body": [
      "صنف ${1:الاسم}:",
      "\tدالة إنشاء(${2:المعاملات}):",
      "\t\t${3:هذا.خاصية = ${2:المعاملات}}"
    ],
    "description": "تعريف صنف مع منشئ"
  },
  "لو": {
    "prefix": "لو",
    "body": [
      "لو ${1:الشرط}:",
      "\t${2:افعل شيئًا}"
    ],
    "description": "جملة شرطية"
  },
  "لووإلا": {
    "prefix": "لووإلا",
    "body": [
      "لو ${1:الشرط}:",
      "\t${2:افعل شيئًا}",
      "وإلا إذا ${3:شرط آخر}:",
      "\t${4:افعل شيئًا آخر}",
      "وإلا:",
      "\t${5:البديل}"
    ],
    "description": "شرط متعدد الفروع"
  },
  "بدّل": {
    "prefix": "بدّل",
    "body": [
      "بدّل ${1:القيمة}",
      "حالة ${2:قيمة}:",
      "\t${3:افعل شيئًا}",
      "افتراض:",
      "\t${4:الحالة الافتراضية}"
    ],
    "description": "بدّل مع حالة وافتراض"
  },
  "طالما": {
    "prefix": "طالما",
    "body": [
      "طالما ${1:الشرط}:",
      "\t${2:افعل شيئًا}"
    ],
    "description": "حلقة طالما"
  },
  "لكل": {
    "prefix": "لكل",
    "body": [
      "لكل ${1:العنصر} في ${2:القائمة}:",
      "\t${3:افعل شيئًا}"
    ],
    "description": "حلقة لكل عنصر"
  },
  "جرب": {
    "prefix": "جرب",
    "body": [
      "جرب:",
      "\t${1:كود قد يخطئ}",
      "باستثناء:",
      "\t${2:معالجة الخطأ}"
    ],
    "description": "معالجة أخطاء"
  },
  "استورد": {
    "prefix": "استورد",
    "body": ["استورد ${1:الوحدة}"],
    "description": "استيراد وحدة"
  },
  "منستورد": {
    "prefix": "منستورد",
    "body": ["من ${1:الوحدة} استورد ${2:الاسم}"],
    "description": "استيراد أسماء محددة من وحدة"
  },
  "سهمية": {
    "prefix": "سهمية",
    "body": ["دالة(${1:المعاملات}) => ${2:التعبير}"],
    "description": "دالة سهمية على سطر واحد"
  },
  "اطبع": {
    "prefix": "اطبع",
    "body": ["اطبع(${1:الرسالة})"],
    "description": "طباعة إلى الشاشة"
  }
}
