{
    "دالة": {
        "prefix": "دالة",
        "body": [
            "دالة ${1:الاسم}(${2:المعاملات}):",
            "\t${3:أعد ${4:القيمة}}"
        ],
        "description": "تعريف دالة جديدة"
    },
    "صنف": {
        "prefix": "صنف",
        "body": [
            "صنف ${1:الاسم}:",
            "\tدالة إنشاء(${2:المعاملات}):",
            "\t\t${3:هذا.خاصية = ${2:المعاملات}}"
        ],
        "description": "تعريف صنف مع منشئ"
    },
    "لو": {
        "prefix": "لو",
        "body": [
            "لو ${1:الشرط}:",
            "\t${2:افعل شيئًا}"
        ],
        "description": "جملة شرطية"
    },
    "لووإلا": {
        "prefix": "لووإلا",
        "body": [
            "لو ${1:الشرط}:",
            "\t${2:افعل شيئًا}",
            "وإلا إذا ${3:شرط آخر}:",
            "\t${4:افعل شيئًا آخر}",
            "وإلا:",
            "\t${5:البديل}"
        ],
        "description": "شرط متعدد الفروع"
    },
    "بدّل": {
        "prefix": "بدّل",
        "body": [
            "بدّل ${1:القيمة}",
            "حالة ${2:قيمة}:",
            "\t${3:افعل شيئًا}",
            "افتراض:",
            "\t${4:الحالة الافتراضية}"
        ],
        "description": "بدّل مع حالة وافتراض"
    },
    "طالما": {
        "prefix": "طالما",
        "body": [
            "طالما ${1:الشرط}:",
            "\t${2:افعل شيئًا}"
        ],
        "description": "حلقة طالما"
    },
    "لكل": {
        "prefix": "لكل",
        "body": [
            "لكل ${1:العنصر} في ${2:القائمة}:",
            "\t${3:افعل شيئًا}"
        ],
        "description": "حلقة لكل عنصر"
    },
    "جرب": {
        "prefix": "جرب",
        "body": [
            "جرب:",
            "\t${1:كود قد يخطئ}",
            "باستثناء:",
            "\t${2:معالجة الخطأ}"
        ],
        "description": "معالجة أخطاء"
    },
    "استورد": {
        "prefix": "استورد",
        "body": [
            "استورد ${1:الوحدة}"
        ],
        "description": "استيراد وحدة"
    },
    "منستورد": {
        "prefix": "منستورد",
        "body": [
            "من ${1:الوحدة} استورد ${2:الاسم}"
        ],
        "description": "استيراد أسماء محددة من وحدة"
    },
    "سهمية": {
        "prefix": "سهمية",
        "body": [
            "دالة(${1:المعاملات}) => ${2:التعبير}"
        ],
        "description": "دالة سهمية على سطر واحد"
    },
    "اطبع": {
        "prefix": "اطبع",
        "body": [
            "اطبع(${1:الرسالة})"
        ],
        "description": "طباعة إلى الشاشة"
    },
    "فنص": {
        "prefix": "فنص",
        "body": [
            "ق\"${1:نص} {${2:المتغير}}\""
        ],
        "description": "نص منسق مع حقن تعبير"
    },
    "خاصية محسوبة": {
        "prefix": "خاصية",
        "body": [
            "خاصية ${1:الاسم}:",
            "    أعد ${2:التعبير}"
        ],
        "description": "خاصية محسوبة داخل صنف"
    },
    "تعداد": {
        "prefix": "تعداد",
        "body": [
            "تعداد ${1:الاسم}:",
            "    ${2:عضو}",
            "    ${3:عضو_آخر}"
        ],
        "description": "تعريف تعداد"
    },
    "خطأ مخصص": {
        "prefix": "خطأ",
        "body": [
            "صنف ${1:خطأ_جديد} من استثناء:",
            "    تجاهل",
            "",
            "جرب:",
            "    ارفع ${1:خطأ_جديد}(\"${2:رسالة}\")",
            "باستثناء ${3:هـ}:",
            "    اطبع(${3:هـ}.رسالة)"
        ],
        "description": "صنف خطأ مخصص مع جرب/باستثناء"
    },
    "قواميس بمفاتيح بلا اقتباس": [
        {
            "prefix": "قاموس-سريع",
            "body": [
                "{${1:المفتاح}: ${2:القيمة}}"
            ],
            "description": "قاموس بمفاتيح بلا اقتباس (جديد في 1.6)"
        }
    ],
    "اختبار يساوي": [
        {
            "prefix": "اختبار-يساوي",
            "body": [
                "اختبارات.يساوي(${1:الفعلي}، ${2:المتوقع}، \"${3:اسم الاختبار}\")"
            ],
            "description": "اختبار مساواة بإطار الاختبارات (جديد في 1.6)"
        }
    ],
    "ملخص الاختبارات": [
        {
            "prefix": "اختبار-ملخص",
            "body": [
                "النتيجة = اختبارات.ملخص()",
                "اطبع(النتيجة[\"ناجح\"]، النتيجة[\"فاشل\"])"
            ],
            "description": "ملخص نتائج الاختبارات (جديد في 1.6)"
        }
    ],
    "خادم ويب": [
        {
            "prefix": "خادم",
            "body": [
                "استورد خادم",
                "",
                "دالة معالج(طلب):",
                "\tلو طلب[\"المسار\"] == \"/${1:/}\":",
                "\t\tأعد {الحالة: 200، النص: \"${2:مرحبا}\"}",
                "\tأعد {الحالة: 404، النص: \"غير موجودة\"}",
                "",
                "المنفذ = خادم.ابدأ(${3:8080}، معالج)",
                "خادم.انتظر()"
            ],
            "description": "خادم ويب كامل (جديد في 1.6)"
        }
    ],
    "نص منسق متعدد الأسطر": [
        {
            "prefix": "فنص-متعدد",
            "body": [
                "ق\"\"\"${1:سطر أول ${2:تعبير}}",
                "${3:سطر ثانٍ}\"\"\""
            ],
            "description": "نص منسق متعدد الأسطر (جديد في 1.6)"
        }
    ],
    "مولد": {
        "prefix": "فمولد",
        "body": [
            "دالة ${1:الاسم}():",
            "    ${2:لكل س في مدى(${3:10}):",
            "        }أنتج ${4:س}"
        ],
        "description": "مولد بكلمة أنتج (جديد في 1.7)"
    },
    "مزخرف": {
        "prefix": "فمزخرف",
        "body": [
            "دالة ${1:الاسم}(د):",
            "    دالة مغلفة(${2:س}):",
            "        ${3:# منطق ما قبل الاستدعاء}",
            "        النتيجة = د(${2:س})",
            "        ${4:# منطق ما بعد الاستدعاء}",
            "        أعد النتيجة",
            "    أعد مغلفة",
            "",
            "@${1:الاسم}",
            "دالة ${5:مزينة}(${2:س}):",
            "    ${6:أعد س}"
        ],
        "description": "مزخرف @ كامل (جديد في 1.7)"
    },
    "قاعدة بيانات": {
        "prefix": "فقاعدة",
        "body": [
            "استورد قاعدة",
            "",
            "ق = قاعدة.افتح(\"${1:قاعدة.db}\")",
            "ق.نفذ(\"CREATE TABLE ${2:جدول} (${3:الاسم TEXT, العمر INTEGER})\")",
            "ق.نفذ(\"INSERT INTO ${2:جدول} VALUES (?, ?)\", [${4:\"قيمة\"}, ${5:1}])",
            "لكل صف في ق.استعلم(\"SELECT * FROM ${2:جدول}\"):",
            "    اطبع(صف)",
            "ق.أغلق()"
        ],
        "description": "قاعدة بيانات SQLite (جديد في 1.7)"
    },
    "وراثة متعددة": {
        "prefix": "فصنف-متعدد",
        "body": [
            "صنف ${1:الابن} من ${2:الأول}، ${3:الثاني}:",
            "    دالة ${4:طريقة}():",
            "        أعد الأصل.${4:طريقة}()"
        ],
        "description": "صنف بوراثة متعددة (جديد في 1.7)"
    },
    "واجهة": {
        "prefix": "فواجهة",
        "body": [
            "واجهة ${1:الاسم}:",
            "    دالة ${2:الطريقة_المجردة}()",
            "",
            "صنف ${3:المنفذ} من ${1:الاسم}:",
            "    دالة ${2:الطريقة_المجردة}():",
            "        ${4:أعد القيمة}"
        ],
        "description": "واجهة + صنف منفذ (جديد في 1.8)"
    },
    "معامل متغير": {
        "prefix": "فمتغير",
        "body": [
            "دالة ${1:الاسم}(...${2:قيم}):",
            "    ${3:أعد طول(${2:قيم})}"
        ],
        "description": "دالة بمعامل متغير ... (جديد في 1.8)"
    },
    "تفكيك": {
        "prefix": "فتفكيك",
        "body": [
            "${1:الناتج} = ${2:الدالة}(...${3:القائمة})"
        ],
        "description": "تفكيك قائمة إلى وسائط (جديد في 1.8)"
    },
    "خيوط": {
        "prefix": "فخيوط",
        "body": [
            "دالة ${1:عمل}(${2:وسيطة}):",
            "    أعد ${3:الوسيطة * ٢}",
            "",
            "خ = خيوط.شغّل(${1:عمل}، ${4:٥})",
            "اطبع(خ.نتيجة())"
        ],
        "description": "تشغيل دالة في خيط (جديد في 1.8)"
    },
    "قفل": {
        "prefix": "فقفل",
        "body": [
            "${1:الحارس} = خيوط.قفل()",
            "${1:الحارس}.احجز()",
            "عالمي ${2:العداد}",
            "${2:العداد} += ١",
            "${1:الحارس}.افرح()"
        ],
        "description": "قفل لحماية بيانات مشتركة (جديد في 1.8)"
    },
    "مطابقة أنماط": {
        "prefix": "طابق",
        "body": [
            "طابق ${1:قيمة}",
            "حالة ${2:نمط}:",
            "    ${3:# الجملة}",
            "غير ذلك:",
            "    ${4:# الجملة الافتراضية}"
        ],
        "description": "مطابقة الأنماط طابق/حالة/غير ذلك"
    },
    "نمط قائمة": {
        "prefix": "نمطقائمة",
        "body": [
            "حالة [${1:أول}، ...بقية]:",
            "    ${2:# الجملة}"
        ],
        "description": "نمط قائمة مع تجميع البقية"
    },
    "سلسلة خام": {
        "prefix": "خام",
        "body": "خ\"${1:نمط}\"",
        "description": "سلسلة خام بلا معالجة الهروب"
    },
    "تاريخ": {
        "prefix": "تواريخ",
        "body": [
            "${1:ت} = تواريخ.أنشئ(${2:٢٠٢٦}، ${3:١}، ${4:١})",
            "اطبع($1.نسق(\"%Y-%m-%d\"))"
        ],
        "description": "إنشاء تاريخ وتنسيقه من وحدة تواريخ"
    },
    "تالٍ": {
        "prefix": "تالٍ",
        "body": [
            "دالة تالٍ():",
            "\tلو ${1:الشرط}:",
            "\t\tأعد ولا شيء",
            "\tأعد ${2:القيمة}"
        ],
        "description": "طريقة تالٍ — بروتوكول التكرار المخصص (إشارة الانتهاء: ولا شيء)"
    },
    "أول": {
        "prefix": "أول",
        "body": [
            "دالة أول():",
            "\tأعد ${1:مؤشر}(${2:الوسائط})"
        ],
        "description": "طريقة أول — تعيد مؤشرًا جديدًا في بداية كل دورة تكرار"
    },
    "مؤشر": {
        "prefix": "مؤشر",
        "body": [
            "صنف ${1:مؤشر_الصنف}:",
            "\tدالة إنشاء(${2:العناصر}):",
            "\t\tهذا.${2:العناصر} = ${2:العناصر}",
            "\t\tهذا.موقع = 0",
            "\tدالة تالٍ():",
            "\t\tلو هذا.موقع >= طول(هذا.${2:العناصر}):",
            "\t\t\tأعد ولا شيء",
            "\t\tالقيمة = هذا.${2:العناصر}[هذا.موقع]",
            "\t\tهذا.موقع = هذا.موقع + 1",
            "\t\tأعد القيمة"
        ],
        "description": "صنف مؤشر كامل لبروتوكول التكرار"
    },
    "إحصاء": {
        "prefix": "إحصاء",
        "body": [
            "من إحصاء استورد ${1:معدل، وسيط، منوال، انحراف}"
        ],
        "description": "استيراد دوال وحدة الإحصاء"
    },
    "فهم قائمة": {
        "prefix": "فهم",
        "body": [
            "[${1:س} * ${1:س} لكل ${1:س} في ${2:متتالية} إن ${3:شرط}]$0"
        ],
        "description": "فهم قائمة: [تعبير لكل س في متتالية إن شرط]"
    },
    "فهم قاموس": {
        "prefix": "فهمق",
        "body": [
            "{${1:مفتاح}: ${2:قيمة} لكل ${3:س} في ${4:متتالية}}$0"
        ],
        "description": "فهم قاموس: {مفتاح: قيمة لكل س في متتالية}"
    },
    "فهم متتالية": {
        "prefix": "فهمم",
        "body": [
            "[${1:تعبير} لكل ${2:أ}، ${3:ب} في ${4:أزواج}$5]$0"
        ],
        "description": "فهم قائمة بتفكيك: [تعبير لكل أ، ب في أزواج]"
    },
    "دالة غير متزامنة": {
        "prefix": "غير متزامنة",
        "body": [
            "غير متزامنة دالة ${1:الاسم}(${2:المعاملات}):",
            "\t${3:الجسم}$0"
        ],
        "description": "دالة غير متزامنة تعمل في خيط ويعيد استدعاؤها مهمة (جديد في 1.15)"
    },
    "انتظر مهمة": {
        "prefix": "انتظر",
        "body": [
            "انتظر ${1:مهمة}$0"
        ],
        "description": "انتظر مهمة غير متزامنة حتى تنتهي واعِ نتيجتها (جديد في 1.15)"
    },
    "انتظر الجميع": {
        "prefix": "انتظر الجميع",
        "body": [
            "انتظر_الجميع([${1:م١}، ${2:م٢}])$0"
        ],
        "description": "انتظر كل المهام واعِ قائمة النتائج بترتيبها (جديد في 1.15)"
    },
    "تجمع خيوط": {
        "prefix": "تجمع",
        "body": [
            "${1:تج} = تجمع(${2:٣})",
            "${3:م} = ${1:تج}.قدّم(${4:دالة}، ${5:معامل})",
            "اطبع(انتظر ${3:م})$0"
        ],
        "description": "تجمع خيوط محدود الحجم: قدّم الأعمال واجمع النتائج بـ انتظر (جديد في 1.16)"
    },
    "تشغيل في عملية منفصلة": {
        "prefix": "شغّل عملية",
        "body": [
            "من عمليات استورد شغّل",
            "${1:ع} = شغّل(${2:دالة}، ${3:معامل})",
            "اطبع(انتظر ${1:ع})$0"
        ],
        "description": "شغّل عملًا مكثفًا حسابيًا في عملية منفصلة تتجاوز قفل التفسير (جديد في 1.17)"
    },
    "تجمع عمليات": {
        "prefix": "تجمع عمليات",
        "body": [
            "من عمليات استورد تجمع",
            "${1:تج} = تجمع(${2:٢})",
            "${3:م} = ${1:تج}.قدّم(${4:دالة}، ${5:معامل})",
            "اطبع(انتظر_الجميع([${3:م}]))",
            "${1:تج}.إنهاء()$0"
        ],
        "description": "تجمع عمليات محدود الحجم موزعًا على الأنوية (جديد في 1.17)"
    }
}
