{
  "name": "arabi-lang",
  "displayName": "لغة عربي — Arabi Language",
  "description": "دعم لغة عربي البرمجية: تلوين بناء الجملة، مقتطفات كود، وخادم لغة (LSP) يوفر التشخيص اللحظي والإكمال الذكي والتلميحات والانتقال إلى التعريف للملفات ذات الامتداد .عربي",
  "version": "1.12.0",
  "publisher": "arabi-lang",
  "license": "MIT",
  "icon": null,
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:arabi",
    "onCommand:arabi.restartServer"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "arabic",
    "arabi",
    "عربي",
    "برمجة",
    "لغة عربية",
    "lsp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "arabi",
        "aliases": [
          "عربي",
          "Arabi",
          "arabi-lang"
        ],
        "extensions": [
          ".عربي"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "arabi",
        "scopeName": "source.arabi",
        "path": "./syntaxes/arabi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "arabi",
        "path": "./snippets/arabi.json"
      }
    ],
    "commands": [
      {
        "command": "arabi.restartServer",
        "title": "عربي: إعادة تشغيل خادم اللغة",
        "category": "عربي"
      },
      {
        "command": "arabi.toggleServer",
        "title": "عربي: تشغيل/إيقاف خادم اللغة",
        "category": "عربي"
      }
    ],
    "configuration": {
      "title": "لغة عربي",
      "properties": {
        "arabi.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "تشغيل خادم اللغة (تشخيص لحظي وإكمال ذكي وتلميحات وانتقال للتعريف)"
        },
        "arabi.languageServer.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "مسار مفسر بايثون المستخدم لتشغيل خادم اللغة"
        },
        "arabi.languageServer.serverPath": {
          "type": "string",
          "default": "",
          "description": "المسار الكامل لمجلد لغة عربي (يحتوي arabi.py). اتركه فارغًا لاستخدام المجلد الحالي للمساحة"
        }
      }
    }
  }
}
