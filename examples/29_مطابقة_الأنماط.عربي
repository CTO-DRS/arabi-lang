# مطابقة الأنماط في لغة عربي — الإصدار 1.9
# طابق تعبير، ثم حالة نمط: — أقوى من "بدّل": الأنماط تلتقط قيمًا وتفكك بِنى
# الأنماط المدعومة: حرفيات، بدائل بأو، التقاط، الرمز البديل _،
#                   حارس إن شرط، قوائم (مع ...البقية)، قواميس، ومسارات قيم

# ---- مثال ١: حرفيات وبدائل ----
دالة نوع_العدد(ن):
    طابق ن
    حالة ٠:
        أعد "صفر"
    حالة -١ أو ١:
        أعد "وحدة!"
    حالة _:
        أعد "عدد آخر"

لكل س في [٠، ١، -١، ٧]:
    اطبع(س، "→", نوع_العدد(س))

# ---- مثال ٢: الالتقاط والحارس ----
# التقاط (اسم) يربط القيمة، والحارس "إن شرط" يضيف شرطًا على النمط
دالة صف_العمر(العمر):
    طابق العمر
    حالة ن إن ن < ١٣:
        أعد "طفل"
    حالة ن إن ن < ١٨:
        أعد "مراهق"
    حالة ن إن ن < ٦٠:
        أعد "بالغ"
    حالة ن:
        أعد "مِعرّم، عمره " + نص(ن)

اطبع("العمر ١٠ →", صف_العمر(١٠))
اطبع("العمر ١٥ →", صف_العمر(١٥))
اطبع("العمر ٣٠ →", صف_العمر(٣٠))
اطبع("العمر ٧٠ →", صف_العمر(٧٠))

# ---- مثال ٣: تفكيك القوائم مع ...البقية ----
# [أول، ...البقية] يربط أول عنصر والباقي قائمة
# التقاط المكرر [أ، أ] يعني "العنصران متساويان"
طابق [٥، ٥، ٦]
حالة [أ]:
    اطبع("عنصر وحيد:", أ)
حالة [أ، أ، أ]:
    اطبع("الثلاثة متساوية:", أ)
حالة [أ، أ، ب]:
    اطبع("أول عنصرين متساويين:", أ، "والثالث مختلف:", ب)
حالة _:
    اطبع("لا نمط يطابق")

طابق [١٠، ٢٠، ٣٠، ٤٠]
حالة [أول، ...البقية]:
    اطبع("أولها", أول، "وبقية القائمة:", البقية)

# ---- مثال ٤: تفكيك القواميس ----
# المفاتيح المطلوبة يجب أن توجد، وما زاد في القاموس لا يضر
طلبات = [
    {النوع: "شراء"، الصنف: "قهوة"، الكمية: ٢}،
    {النوع: "إلغاء"، السبب: "تأخر"}،
]

لكل طلب في طلبات:
    طابق طلب
    حالة {النوع: "شراء"، الصنف: اسم_الصنف، الكمية: كم}:
        اطبع("أمر شراء:", كم، "من", اسم_الصنف)
    حالة {النوع: "إلغاء"، السبب: سبب}:
        اطبع("أمر إلغاء بسبب:", سبب)
    حالة _:
        اطبع("طلب غير مفهوم")

# ---- مثال ٥: مسارات القيم مع التعدادات ----
# نمط القيمة تعداد.عضو يقارن بالمساواة — مثالي للتعدادات
تعداد حالة_الطلب:
    جديد
    قيد_التنفيذ
    مكتمل
    ملغى

دالة الخطوة_التالية(الحالة):
    طابق الحالة
    حالة حالة_الطلب.جديد:
        أعد "ابدأ التنفيذ"
    حالة حالة_الطلب.قيد_التنفيذ:
        أعد "انتظر الاكتمال"
    حالة حالة_الطلب.مكتمل أو حالة_الطلب.ملغى:
        أعد "لا شيء — انتهى الطلب"

لكل عضو في [حالة_الطلب.جديد، حالة_الطلب.قيد_التنفيذ، حالة_الطلب.ملغى]:
    اطبع(عضو.الاسم، "→", الخطوة_التالية(عضو))

# ---- مثال ٦: مطابقة معقدة — شجرة تعبير بسيطة ----
# الأنماط المتداخلة تفكك البِنى العميقة في نمط واحد مقروء
دالة تقييم(عقدة):
    طابق عقدة
    حالة {نوع_العقدة: "عدد"، القيمة: ن}:
        أعد ن
    حالة {نوع_العقدة: "جمع"، الأطراف: [أ، ب]}:
        أعد تقييم(أ) + تقييم(ب)
    حالة {نوع_العقدة: "ضرب"، الأطراف: [أ، ب]}:
        أعد تقييم(أ) * تقييم(ب)
    حالة _:
        ارفع "عقدة غير معروفة"

التعبير = {نوع_العقدة: "جمع"، الأطراف: [
    {نوع_العقدة: "عدد"، القيمة: ٣}،
    {نوع_العقدة: "ضرب"، الأطراف: [
        {نوع_العقدة: "عدد"، القيمة: ٤}،
        {نوع_العقدة: "عدد"، القيمة: ٥}،
    ]}،
]}

اطبع("ناتج شجرة التعبير:", تقييم(التعبير))
