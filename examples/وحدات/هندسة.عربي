# ============================================
#  وحدة هندسة — دوال وثوابت هندسية
#  تُستورد بـ: استورد هندسة
#  أو: من هندسة استورد مساحة_الدائرة
# ============================================

# الثوابت
ط = ٣.١٤١٥٩٢٦٥
الاسم = "وحدة الهندسة الإصدار ١"

# المساحة والمحيط
دالة مساحة_الدائرة(نق):
    أعد ط * نق * نق

دالة محيط_الدائرة(نق):
    أعد ٢ * ط * نق

دالة مساحة_المستطيل(العرض، الارتفاع):
    أعد العرض * الارتفاع

دالة نظرية_فيثاغورس(أ، ب):
    أعد رياضيات.جذر(أ * أ + ب * ب)

# دالة تستخدم وحدة رياضيات الجاهزة (متاحة داخل كل وحدة)
دالة جيب_الزاوية(بالدرجات):
    أعد رياضيات.جيب(بالدرجات * ط / ١٨٠)
