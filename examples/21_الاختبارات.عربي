# ============================================
#  إطار الاختبارات: تحقق من كودك ببلغة عربي
# ============================================

استورد اختبارات

# ---- الدوال التي سنختبرها ----

دالة جمع(أ، ب):
    أعد أ + ب

دالة قسمة(أ، ب):
    لو ب == ٠:
        ارفع "لا يمكن القسمة على صفر"
    أعد أ / ب

# ---- كتابة الاختبارات ----

اختبارات.ابدأ("اختبارات الحساب")

# يساوي: مقارنة الناتج بالمتوقع
اختبارات.يساوي(جمع(٢، ٣)، ٥، "جمع عددين موجبين")
اختبارات.يساوي(جمع(-١، ١)، ٠، "جمع عددين متعاكسين")

# يختلف: يجب أن تكون القيمتان مختلفتين
اختبارات.يختلف(جمع(١، ١)، ٣، "الجمع ليس مكسورًا")

# يصح / يخطئ: فحص قيمة صحية أو خاطئة
اختبارات.يصح(طول("عربي") > ٠، "النص غير فارغ")
اختبارات.يخطئ([]، "القائمة الفارغة خاطئة")

# يرفع: يتأكد أن الدالة ترفع خطأ عند الشرط
اختبارات.يرفع(دالة() => قسمة(٥، ٠)، "القسمة على صفر ترفع خطأ")

# ---- الملخص ----

النتيجة = اختبارات.ملخص()

# النتيجة قاموس يمكن استخدامه برمجيًا
لو النتيجة["فاشل"] > ٠:
    اطبع("توجد اختبارات فاشلة!")
وإلا:
    اطبع("كل الاختبارات ناجحة — الكود سليم")
