# الوحدات القياسية الجديدة في لغة عربي — الإصدار 1.5
# عشوائية، تنظيم (التعبيرات النمطية)، تحويل (الأرقام العربية)، نظام

# ---- وحدة عشوائية ----
عشوائية.بذرة(٢٠٢٦)                      # بذرة ثابتة لتكرار النتيجة
اطبع("عدد عشوائي من ١ إلى ١٠٠: " + نص(عشوائية.صحيح(١، ١٠٠)))

فريق = ["أحمد"، "سارة"، "خالد"، "منى"]
اطبع("اختيار قائد الفريق: " + عشوائية.اختيار(فريق))
اطبع("ترتيب عشوائي: " + نص(عشوائية.خلط(فريق)))
اطبع("لجنة من ٢ أعضاء: " + نص(عشوائية.عينة(فريق، ٢)))

# ---- وحدة تنظيم: التعبيرات النمطية ----
رسالة = "تواصل معنا على البريد info@example.com أو الهاتف ٠٥٥١٢٣٤٥٦٧"

بريد = تنظيم.يجد("[\\w.]+@[\\w.]+"، رسالة)
اطبع("البريد المستخرج: " + بريد)

أرقام = تنظيم.كل_المطابقات("[٠-٩]+"، رسالة)
اطبع("الأرقام المستخرجة: " + نص(أرقام))

نص_منظم = تنظيم.يستبدل("\\s+"، " "، "جملة   فيها    مسافات   كثيرة")
اطبع("النص المنظم: " + نص_منظم)

كلمات = تنظيم.ينقسم("[،]"، "تفاح، موز، عنب، رمان")
اطبع("ثمار العصيدة: " + نص(كلمات))

لو تنظيم.يبدأ("مرحبا"، "مرحبا بالعالم"):
    اطبع("النص يبدأ بكلمة مرحبا")

# ---- وحدة تحويل: الأرقام العربية والتفقيط ----
اطبع("تحويل إلى كلمات: " + تحويل.كلمات(١٩٢٦))
اطبع("عام جديد: " + تحويل.كلمات(٢٠٢٦))
اطبع("مبلغ عربي: " + تحويل.كلمات(١٥٠٠٠٠) + " ريال")
اطبع("أرقام شرقية: " + تحويل.إلى_شرقية("الإصدار 1.5"))
اطبع("أرقام غربية: " + تحويل.إلى_غربية("سنة ٢٠٢٦"))

# ---- توسيع وحدة رياضيات ووقت ----
اطبع("مشترك الأكبر لـ ٤٨ و ٣٦: " + نص(رياضيات.مشترك_الأكبر(٤٨، ٣٦)))
اطبع("مشترك الأصغر لـ ٤ و ٦: " + نص(رياضيات.مشترك_الأصغر(٤، ٦)))
اطبع("علامة -٩: " + نص(رياضيات.علامة(-٩)))

الآن = وقت.الآن()
اطبع("اليوم: " + الآن["يوم_الأسبوع"])
اطبع("التاريخ: " + وقت.تنسيق("%ي/%ش/%س"))

# ---- وحدة نظام ----
اطبع("نظام التشغيل: " + نظام.النظام())
اطبع("مجلد العمل: " + نظام.مجلد_العمل())
اطبع("اسم الملف: " + نظام.اسم_الملف(نظام.فصل("مجلدات"، "برنامج.عربي")))
