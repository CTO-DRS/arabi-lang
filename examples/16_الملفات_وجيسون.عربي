# الملفات وجيسون في لغة عربي
# وحدة "ملفات": اكتب، اقرأ، أضف، أسطر، موجود، احذف
# وحدة "جيسون": نص (تحويل إلى JSON)، حلل (قراءة JSON)

# ---- مثال ١: كتابة وقراءة ملف نصي ----
الطريق = "ملاحظات_الطالب.txt"

ملفات.اكتب(الطريق، "مواد الفصل الأول:\n")
ملفات.أضف(الطريق، "- الرياضيات\n")
ملفات.أضف(الطريق، "- الفيزياء\n")
ملفات.أضف(الطريق، "- البرمجة\n")

اطبع("هل الملف موجود؟", ملفات.موجود(الطريق))
اطبع("أسطر الملف:", طول(ملفات.أسطر(الطريق)))
اطبع("--- محتوى الملف ---")
اطبع(ملفات.اقرأ(الطريق))

# ---- مثال ٢: حفظ قاموس في ملف بصيغة جيسون ----
طالب = {
    "الاسم": "نورة",
    "العمر": 17,
    "المواد": ["الرياضيات"، "البرمجة"، "الكيمياء"],
    "متفوق": صح
}

ملف_بيانات = "طالب.json"
ملفات.اكتب(ملف_بيانات، جيسون.نص(طالب))
اطبع("حُفظت بيانات الطالب في ملف جيسون")

# ---- مثال ٣: قراءة البيانات من الملف واستخدامها ----
محتوى = ملفات.اقرأ(ملف_بيانات)
محمل = جيسون.حلل(محتوى)

اطبع("الاسم:", محمل["الاسم"])
اطبع("العمر:", محمل["العمر"])
اطبع("عدد المواد:", طول(محمل["المواد"]))

# مرشّح المواد الطويلة (أكثر من ٦ أحرف)
الطويلة = مرشّح(دالة(م) => طول(م) >= 6، محمل["المواد"])
اطبع("المواد بأسماء طويلة:", الطويلة)

# ---- مثال ٤: دفتر درجات — حساب المعدل وتحديث الملف ----
درجات = [95، 88، 91، 78]
المعدل = اختزل(دالة(مجموع، د) => مجموع + د، درجات) / طول(درجات)
اطبع("المعدل العام:", تقريب(المعدل، 2))

سجل = جيسون.نص({"المعدل": تقريب(المعدل، 2)، "عدد_المواد": طول(درجات)})
ملفات.أضف(ملف_بيانات، "\n" + سجل)
اطبع("أُضيف سجل المعدل إلى ملف البيانات")

# ---- تنظيف الملفات المؤقتة ----
ملفات.احذف(الطريق)
ملفات.احذف(ملف_بيانات)
اطبع("هل الملفات موجودة بعد الحذف؟", ملفات.موجود(الطريق) أو ملفات.موجود(ملف_بيانات))
