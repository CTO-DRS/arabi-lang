# الواجهات في لغة عربي — الإصدار ١.٨
# الواجهة = عقد مجرد: تُعلن الطرق المطلوبة، وتلتزم بها الأصناف
# طريقة بلا جسم = مجردة (يجب تنفيذها) — طريقة بجسم = تنفيذ افتراضي يورث

واجهة شكل:
    # طرق مجردة — كل صنف منفذ يجب أن يوفرها
    دالة مساحة()
    دالة محيط()

    # تنفيذ افتراضي — يورثه كل منفذ تلقائيًا
    دالة وصف():
        أعد "شكل مساحته " + نص(هذا.مساحة())

# واجهة تمتد واجهة أخرى — تضيف التزامات جديدة
واجهة شكل_مرسوم من شكل:
    دالة ارسم()

# ─── صنف ينفذ الواجهة كاملة ───

صنف دائرة من شكل_مرسوم:
    دالة إنشاء(ن):
        هذا.ن = ن

    دالة مساحة():
        أعد ٣.١٤ * هذا.ن * هذا.ن

    دالة محيط():
        أعد ٢ * ٣.١٤ * هذا.ن

    دالة ارسم():
        أعد "دائرة نصف قطرها " + نص(هذا.ن)

# ─── صنف آخر ينفذ نفس الواجهة ───

صنف مربع من شكل_مرسوم:
    دالة إنشاء(ض):
        هذا.ض = ض

    دالة مساحة():
        أعد هذا.ض * هذا.ض

    دالة محيط():
        أعد ٤ * هذا.ض

    دالة ارسم():
        أعد "مربع ضلعه " + نص(هذا.ض)

# ─── صنف وسيط يكمل نصف العقد ───

صنف مثلث_قاعدة من شكل:
    دالة إنشاء(ق، ع):
        هذا.ق = ق
        هذا.ع = ع

    دالة مساحة():
        أعد ٠.٥ * هذا.ق * هذا.ع
    # لم ينفذ محيط — لذا هو مجرد ولا يمكن إنشاؤه مباشرة

صنف مثلث من مثلث_قاعدة، شكل_مرسوم:
    دالة محيط():
        أعد ٣ * هذا.ق

    دالة ارسم():
        أعد "مثلث قاعدته " + نص(هذا.ق)

# ─── الاستخدام ───

أشكال = [دائرة(٢)، مربع(٣)، مثلث(٤، ٥)]

لكل ش في أشكال:
    اطبع(ش.ارسم())
    اطبع("   " + ش.وصف())

# ─── المحاولة الفاشلة: صنف لم يلتزم بالعقد ───

صنف مربع_كسول من شكل:
    تجاهل

جرب:
    مربع_كسول()
باستثناء هـ:
    اطبع("خطأ متوقع: " + هـ)
