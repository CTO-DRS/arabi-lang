# المزخرف = دالة تستقبل دالة وتعيد دالة محسّنة — تُكتب بعلامة @ فوق التعريف

# ١) مزخرف يقيس زمن التنفيذ
دالة زمني(د):
    دالة مغلفة(أ، ب):
        البداية = وقت.زمن()
        النتيجة = د(أ، ب)
        المدة = وقت.زمن() - البداية
        اطبع("  ← استغرق " + نص(تقريب(المدة * 1000، 2)) + " م.ث")
        أعد النتيجة
    أعد مغلفة

استورد وقت

@زمني
دالة مجموع_كبير(من، إلى):
    المجموع = 0
    لكل س في مدى(من، إلى):
        المجموع += س
    أعد المجموع

اطبع("التنفيذ الأول:")
اطبع("الناتج: " + نص(مجموع_كبير(1، 100000)))

# ٢) مزخرف ذاكرة (تخزين مؤقت للنتائج)
ذاكرة = {}

دالة محفوظ(د):
    دالة مغلفة(س):
        لو س في ذاكرة:
            اطبع("  [من الذاكرة] فيبوناتشي(" + نص(س) + ")")
            أعد ذاكرة[س]
        النتيجة = د(س)
        ذاكرة[س] = النتيجة
        أعد النتيجة
    أعد مغلفة

@محفوظ
دالة فيبوناتشي(ن):
    لو ن <= 1:
        أعد ن
    أعد فيبوناتشي(ن - 1) + فيبوناتشي(ن - 2)

اطبع("فيبوناتشي(15) = " + نص(فيبوناتشي(15)))
اطبع("فيبوناتشي(15) مجددًا = " + نص(فيبوناتشي(15)))

# ٣) الوراثة المتعددة: صنف يرث من أصناف عدة بفواصل
صنف طائر:
    دالة تحرك():
        أعد "يطير في السماء"

صنف سباح:
    دالة تحرك():
        أعد "يسبح في الماء"

صنف طائر_مائي من طائر، سباح:
    دالة تعريف():
        # الأصل = أول صنف في القائمة
        أعد "أنا بطائر مائي: " + الأصل.تحرك()

صنف بطة من طائر_مائي:
    دالة صوت():
        أعد "كواك!"

بطة_صغيرة = بطة()
اطبع(بطة_صغيرة.تعريف())
اطبع("الصوت: " + بطة_صغيرة.صوت())

# ٤) ترتيب حل الطرق (MRO): الأقرب أولًا — المعين
صنف كائن_أساسي:
    دالة من_أنا():
        أعد "كائن أساسي"

صنف طائر_معين من كائن_أساسي:
    دالة من_أنا():
        أعد "طائر"

صنف سباح_معين من كائن_أساسي:
    دالة من_أنا():
        أعد "سباح"

صنف بطريق من طائر_معين، سباح_معين:
    تجاهل

بطريق_صغير = بطريق()
# البطريق يرث "طائر" لأنه أول أصل — دلالة C3 مثل بايثون
اطبع("من أنا؟ " + بطريق_صغير.من_أنا())
