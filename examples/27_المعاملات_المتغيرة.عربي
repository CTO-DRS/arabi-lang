# المعاملات المتغيرة والتفكيك — الإصدار ١.٨
# ...الاسم داخل تعريف الدالة يجمع الوسائط الزائدة في قائمة
# ...التعبير عند الاستدعاء يفتّ القائمة إلى وسائط منفصلة

# ─── دالة تقبل عددًا غير محدود من الوسائط ───

دالة مجموع(...أرقام):
    م = ٠
    لكل أ في أرقام:
        م += أ
    أعد م

اطبع(مجموع(١، ٢))
اطبع(مجموع(١، ٢، ٣، ٤، ٥))
اطبع(مجموع())                      # قائمة فارغة

# ─── خلط معاملات ثابتة مع المتغيرة ───

دالة تقرير(عنوان، ...قيم):
    أعد عنوان + ": " + نص(قيم)

اطبع(تقرير("درجات الحرارة"، ٢٨، ٣١، ٣٠))

# ─── التفكيك عند الاستدعاء: افتّ القائمة إلى وسائط ───

دالة أقصى(أ، ب):
    لو أ > ب:
        أعد أ
    أعد ب

درجات = [٤٢، ٣٧]
اطبع("الأعلى: " + نص(أقصى(...درجات)))

# التفكيك يُخلط بالوسائط العادية بالترتيب
دالة مقدمة(اسم، لقب، مدينة):
    أعد لقب + " " + اسم + " — " + مدينة

بيانات = ["أحمد"، "المهندس"]
اطبع(مقدمة(...بيانات، "الرياض"))

# ─── التفكيك داخل القوائم الحرفية ───

أساس = [٢، ٣]
ممتدة = [١، ...أساس، ٤، ٥]
اطبع(ممتدة)

# دمج قائمتين بلا حلقة
أ = [١٠، ٢٠]
ب = [٣٠، ٤٠]
اطبع([...أ، ...ب])

# تفكيك نص حرفًا حرفًا ومدى
اطبع([..."عربي"])
اطبع([...مدى(٣)])

# ─── تفكيك المولدات (من الإصدار ١.٧) ───

دالة الأعداد_الزوجية(حتى):
    لكل س في مدى(٢، حتى + ١، ٢):
        أنتج س

دالة مجموع(...قيم):
    م = ٠
    لكل ق في قيم:
        م += ق
    أعد م

اطبع("مجموع الزوجية: " + نص(مجموع(...الأعداد_الزوجية(١٠))))

# ─── دوال سهمية بمعاملات متغيرة ───

احصاء = دالة(...قيم) => "العدد: " + نص(طول(قيم)) + "، الأوسط: " + نص(قيم[رياضيات.أرضية(طول(قيم) / ٢)])
اطبع(احصاء("أ"، "ب"، "ج"))
