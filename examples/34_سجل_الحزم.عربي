# =====================================================
#  سجل الحزم — استخدام حزمة مثبتة في مجلد حزم/
# =====================================================
# حزمة «مبيعات» مثبتة هنا: examples/حزم/مبيعات/
# هكذا تظهر الحزم بعد أمر مثل:
#     python arabi.py حزمة تثبيت مبيعات
#
# المفسّر يبحث عن الوحدات المستوردة بالترتيب:
#   مجلد البرنامج ← وحدات/ ← مكتبات/ ← حزم/
#
# حزمة.json داخل مجلد الحزمة تحدد النسخة والمدخل:
#   { "الاسم": "مبيعات"، "النسخة": "1.3.0"، "المدخل": "مبيعات.عربي" }

استورد مبيعات

المبالغ = [1200، 850، 2400، 975، 3100]
الشهور = ["يناير"، "فبراير"، "مارس"، "أبريل"، "مايو"]

اطبع("الإجمالي:", مبيعات.الإجمالي(المبالغ))
اطبع("المتوسط:", مبيعات.المتوسط(المبالغ))
اطبع("أعلى مبيعات:", مبيعات.الأعلى(المبالغ))
اطبع("")

لكل سطر في مبيعات.تقرير(الشهور، المبالغ):
    اطبع(سطر)
