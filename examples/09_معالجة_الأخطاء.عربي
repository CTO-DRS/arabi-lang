# ============================================
#  معالجة الأخطاء: جرب، باستثناء، اخيرا، ارفع
# ============================================

# القسمة على صفر
جرب:
    اطبع(١٠ / ٠)
    اطبع("لن يُطبع هذا السطر")
باستثناء:
    اطبع("خطأ: لا يمكن القسمة على صفر")

# تحويل نص غير رقمي
جرب:
    اطبع(عدد("بلا أرقام"))
باستثناء:
    اطبع("خطأ: النص لا يمكن تحويله إلى عدد")

# فهرس خارج النطاق
جرب:
    أرقام = [١، ٢، ٣]
    اطبع(أرقام[١٠])
باستثناء:
    اطبع("خطأ: الفهرس خارج نطاق القائمة")

# كتلة "اخيرا" تُنفذ دائمًا
جرب:
    اطبع("داخل كتلة جرب")
باستثناء:
    اطبع("لن يُنفذ هذا")
اخيرا:
    اطبع("كتلة اخيرا تُنفذ دائمًا")

# رمي خطأ مخصص بـ "ارفع"
دالة تحقق_العمر(العمر):
    لو العمر < ٠:
        ارفع "العمر لا يمكن أن يكون سالبًا"
    أعد العمر

جرب:
    تحقق_العمر(-٥)
باستثناء:
    اطبع("تم اكتشاف خطأ: عمر سالب")

جرب:
    تحقق_العمر(٢٥)
باستثناء:
    اطبع("لن يُنفذ هذا")
اطبع("البرنامج اكتمل بنجاح رغم الأخطاء!")
