# ١) الدوال السهمية — دالة على سطر واحد بتعبير واحد
ضاعف = دالة(س) => س * ٢
اطبع("ضاعف(٢١) =", ضاعف(٢١))

اجمع = دالة(أ، ب) => أ + ب
اطبع("اجمع(٣، ٤) =", اجمع(٣، ٤))

# بدون معاملات
درج = دالة() => "مرحبا من الدالة السهمية!"
اطبع(درج())

# مع قيمة افتراضية
مربع_زائد = دالة(س = ١٠) => س * س + ١
اطبع("مربع_زائد() =", مربع_زائد())
اطبع("مربع_زائد(٥) =", مربع_زائد(٥))

# استدعاء فوري دون تخزين
اطبع("استدعاء فوري:", (دالة(س) => س + ١)(٤١))

# ٢) الدوال السهمية قيم — تُخزن في القوائم وتُمرر كمعاملات
عمليات = [دالة(س) => س + ١، دالة(س) => س * ١٠]
اطبع("عمليات[٠](٥) =", عمليات[٠](٥))
اطبع("عمليات[١](٥) =", عمليات[١](٥))

دالة طبق(قيمة، تحويل):
    أعد تحويل(قيمة)

اطبع("طبق(٥، تحويل سهمي):", طبق(٥، دالة(س) => س * س))

# الإغلاق: السهمية تلتقط متغيرات محيطها
العامل = ٣
دالة_التحويل = دالة(س) => س * العامل
اطبع("إغلاق يلتقط العامل=٣:", دالة_التحويل(٧))

# ٣) القيم الافتراضية في الدوال العادية
دالة ترحيب(الاسم، تحية = "مرحبا"):
    أعد تحية + " " + الاسم

اطبع(ترحيب("أحمد"))                    # تستخدم الافتراضي
اطبع(ترحيب("سارة"، "أهلاً"))            # تستبدل الافتراضي

# ٤) المعاملات بالاسم — أوضح وأسهل قراءة
دالة فاتورة(الصنف، الكمية = ١، سعر = ١٠):
    أعد الصنف + ": " + نص(الكمية * سعر) + " ريال"

اطبع(فاتورة("قلم"))
اطبع(فاتورة("دفتر"، ٣))
اطبع(فاتورة("حاسبة"، سعر = ١٥٠))
اطبع(فاتورة("كرسي"، الكمية = ٤، سعر = ٧٥))

# ٥) المعاملات بالاسم مع الطرق والأصناف
صنف دائرة:
    دالة إنشاء(نق = ١):
        هذا.نق = نق
    دالة مساحة():
        أعد ٣.١٤ * هذا.نق * هذا.نق

ك = دائرة(نق = ٢)
اطبع("مساحة دائرة نق ٢:", ك.مساحة())
