# مثال ٤٥ — مواصفة اللغة ١٫٢٤: القرارات المحسومة في برنامج واحد
# المواصفة الكاملة: docs/مواصفة-اللغة.md
# يغطي: ٪ و٪= (ق١)، التشكيل (ق٢)، الكشيدة وإرشادها (ق٣)، أرقام ٫ و٬ (ق٥)
#        والتقاط بالصنف بكـ (ق٦) والمزخرف مع غير المتزامنة (ق٩)

اطبع("=== باقي القسمة بالعلامة العربية ===")
اطبع("١٠ ٪ ٣ =", ١٠ ٪ ٣)
اطبع("−١٠ ٪ ٣ =", -١٠ ٪ ٣)
باقٍ = ٢٣
باقٍ ٪= ٥
اطبع("٢٣ ٪= ٥ →", باقٍ)
اطبع("ألفان ومئتان وأربعة وثلاثون:", ١٬٢٣٤)
اطبع("ثلاثة فاصلة أربعة عشر:", ٣٫١٤)

اطبع("=== التشكيل لا يميز ===")
مُرَجِّع = ١٠٠
مرجع = مُرَجِّع + ١
اطبع("المرجعان متغير واحد:", مرجع)

اطبع("=== التقاط بالصنف ===")
صنف خطأ_دفع من استثناء:
    دالة إنشاء(رسالة):
        هذا.رسالة = رسالة

صنف خطأ_رصيد من خطأ_دفع:
    دالة إنشاء(رسالة):
        الأصل.إنشاء(رسالة)

دالة سحب(مبلغ):
    لو مبلغ > ١٠٠٠:
        ارفع خطأ_رصيد("الرصيد لا يسمح بسحب " + نص(مبلغ))
    وإلا:
        أعد "سُحب " + نص(مبلغ)

جرب:
    اطبع(سحب(٢٠٠))
    اطبع(سحب(٢٠٠٠))
باستثناء خطأ_رصيد كـ هـ:
    اطبع("رصيد:", هـ.رسالة)
باستثناء خطأ_دفع كـ هـ:
    اطبع("دفع عام:", هـ.رسالة)
باستثناء كـ هـ:
    اطبع("عام:", هـ)

اطبع("=== المزخرف مع غير المتزامنة ===")
# المزخرف يغلّف الدالة غير المتزامنة ويمرر المهمة كما هي —
# والاستدعاء يبقى مهمة تُنتظر بـ«انتظر»
دالة المؤقّت(ف):
    دالة داخلية(...الوسائط):
        اطبع("بدأت المهمة…")
        أعد ف(...الوسائط)
    أعد داخلية

@المؤقّت
غير متزامنة دالة مهمة(س):
    أعد س * ٢

ن = مهمة(٢١)
اطبع("النتيجة:", انتظر ن)

