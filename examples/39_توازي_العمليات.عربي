# توازي العمليات (الإصدار 1.17) — أعمال مكثفة حسابيًا على كل الأنوية
# وحدة 'عمليات' تشغل الكود في معالجات منفصلة حقيقية بذاكرة معزولة،
# فتتجاوز قفل التفسير العالمي الذي يحد الخيوط. الواجهة نفسها التي
# تعرفها من 'خيوط' و'تجمع': شغّل/قدّم/انتظر/انتظر_الجميع.

من عمليات استورد شغّل، تجمع، معالجات

اطبع("أنوية المعالج المتاحة: " + نص(معالجات()))

# ===== ١) دالة حسابية خالصة: كل عملية تستفيد من نواة مستقلة =====

دالة مجموع_مربعات(ن):
    م = ٠
    لكل س في مدى(ن):
        م = م + س * س
    أعد م

ع = شغّل(مجموع_مربعات، ٢٠٠٠٠٠)
اطبع("مجموع المربعات حتى ٢٠٠٠٠٠ (في عملية منفصلة): "
     + نص(انتظر ع))

# ===== ٢) الربط العالمي يسافر مع الدالة =====
# الدالة التي تستدعي دوالًا عالمية أخرى أو تستخدم ثوابت معرفة أعلى
# البرنامج تعمل في العملية الابن كما تعمل هنا تمامًا.

دالة مضروب(ن):
    لو ن <= ١:
        أعد ١
    أعد ن * مضروب(ن - ١)

حد = ٢٠
دالة مضروب_الحد(ن):
    أعد مضروب(ن) * حد / حد        # يستخدم العالمي: مضروب وحد

اطبع("مضروب ٢٠ (تعاود عبر العالمي في العملية الابن): "
     + نص(انتظر شغّل(مضروب_الحد، ٢٠)))

# ===== ٣) تجمع عمليات: مهام متوازية ونتائج بترتيب التقديم =====

تج = تجمع(٢)
مهام = []
لكل حجم في [٥٠٠٠٠، ١٠٠٠٠٠، ١٥٠٠٠٠]:
    مهام.أضف(تج.قدّم(مجموع_مربعات، حجم))

نتائج = انتظر_الجميع(مهام)
اطبع("نتائج التجمع بترتيب التقديم: " + نص(نتائج))
تج.إنهاء()

# ===== ٤) الأخطاء تعبر العمليات بهويتها =====

صنف خطأ_تحقق من استثناء:
    تجاهل

دالة تحقق_موجب(ن):
    لو ن < ٠:
        ارفع خطأ_تحقق("قيمة سالبة وصلت إلى العملية المنفصلة")
    أعد ن * ٢

جرب:
    انتظر شغّل(تحقق_موجب، -٥)
باستثناء هـ:
    اطبع("التُقط خطأ العملية: " + هـ.رسالة)

# ===== ٥) الكائنات تعود من العملية بطرقها الصالحة =====

صنف نتيجة:
    دالة إنشاء(الاسم، القيمة):
        هذا.الاسم = الاسم
        هذا.القيمة = القيمة
    دالة عرض():
        أعد هذا.الاسم + " = " + نص(هذا.القيمة)

دالة لخّص(ن):
    أعد نتيجة("متوسط المربعات", مجموع_مربعات(ن) / ن)

ك = انتظر شغّل(لخّص، ١٠٠)
اطبع("كائن عاد من عملية منفصلة: " + ك.عرض())
