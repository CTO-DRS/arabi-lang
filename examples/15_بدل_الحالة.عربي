# جملة "بدّل" في لغة عربي — بديل أنظف لسلسلة طويلة من "لو"
# بدّل التعبير، ثم حالة قيمة: وافتراض: للحالة الافتراضية
# كل حالة تُنفَّذ وحدها (لا تساقط)، و"كسر" يخرج من الحلقة المحيطة

# ---- مثال ١: أيام الأسبوع ----
دالة وصف_اليوم(يوم):
    بدّل يوم
    حالة "السبت":
        أعد "بداية عطلة نهاية الأسبوع"
    حالة "الأحد":
        أعد "عطلة كاملة"
    حالة "الخميس":
        أعد "آخر أيام العمل"
    افتراض:
        أعد "يوم عمل عادي"

اطبع("السبت →", وصف_اليوم("السبت"))
اطبع("الأحد →", وصف_اليوم("الأحد"))
اطبع("الثلاثاء →", وصف_اليوم("الثلاثاء"))

# ---- مثال ٢: بدّل مع أعداد ----
استورد رياضيات

دالة تقييم_الدرجة(درجة):
    بدّل رياضيات.أرضية(درجة / 10)
    حالة 10:
        أعد "ممتاز مرتفع"
    حالة 9:
        أعد "ممتاز"
    حالة 8:
        أعد "جيد جدًا"
    حالة 7:
        أعد "جيد"
    افتراض:
        أعد "يحتاج اجتهادًا أكثر"

لكل د في [95، 87، 72، 60]:
    اطبع(د، "→", تقييم_الدرجة(د))

# ---- مثال ٣: كسر داخل بدّل داخل حلقة ----
# "كسر" داخل "بدّل" يكسر الحلقة المحيطة إن وُجدت
أرقام = [4، 8، 15، 16، 23، 42]
لكل س في أرقام:
    بدّل س
    حالة 16:
        اطبع("وجدت الرقم السري ١٦ — توقف البحث")
        كسر
    افتراض:
        اطبع("فحصنا:", س)

# ---- مثال ٤: بدّل في قاموس محاكاة قائمة أوامر ----
أوامر = ["فتح"، "حفظ"، "خروج"]
لكل أمر في أوامر:
    بدّل أمر
    حالة "فتح":
        اطبع("جارٍ فتح الملف...")
    حالة "حفظ":
        اطبع("جارٍ حفظ التغييرات...")
    حالة "خروج":
        اطبع("إلى اللقاء!")
    افتراض:
        اطبع("أمر غير معروف:", أمر)
