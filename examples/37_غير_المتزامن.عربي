# غير المتزامن (الإصدار 1.15)
# الدالة غير المتزامنة تعمل في خيط مستقل فور استدعائها، ويعيد الاستدعاء
# «مهمة» تنتظر نتيجتها بكلمة «انتظر» — والبقية يواصلون العمل بالتوازي.

اطبع("=== ١) مهمة بسيطة ===")

غير متزامنة دالة اطبخ(الطبق، دقائق):
    انتظر_زمن(دقائق * 0.01)
    أعد الطبق + " جاهز بعد " + نص(دقائق) + " دقائق"

مهمة_شوربة = اطبخ("الشوربة", 2)
اطبع("هل انتهت فورًا؟ " + نص(مهمة_شوربة.جاهز()))
اطبع("النتيجة: " + انتظر مهمة_شوربة)
اطبع("بعد الانتظار: " + نص(مهمة_شوربة.جاهز()))

اطبع("=== ٢) مهام متوازية مع انتظر_الجميع ===")
# الثلاث تعمل معًا؛ انتظر_الجميع تعيد النتائج بترتيبها الأصلي مهما سبق من.

غير متزامنة دالة حضّر(الخطوة، مدة):
    انتظر_زمن(مدة * 0.01)
    أعد "تمّت " + الخطوة

م١ = حضّر("العجين", 6)
م٢ = حضّر("الصلصة", 1)
م٣ = حضّر("الإضافات", 3)
نتائج = انتظر_الجميع([م١، م٢، م٣])
لكل نتيجة في نتائج:
    اطبع(نتيجة)

اطبع("=== ٣) سباق: من يسبق؟ ===")
# يعيد «سباق» أول مهمة تنتهي — هنا الفارق واضح فالناتج محدد.

غير متزامنة دالة عدّاء(الاسم، مدة):
    انتظر_زمن(مدة)
    أعد الاسم

فائز = سباق([عدّاء("الأبطأ", 0.2)، عدّاء("الأسرع", 0.01)])
اطبع("الفائز: " + انتظر فائز)

اطبع("=== ٤) طرق غير متزامنة داخل أصناف ===")

صنف خادم_ويب:
    دالة إنشاء(الاسم):
        هذا.الاسم = الاسم
    غير متزامنة دالة خدّم(رقم_الطلب):
        انتظر_زمن(0.02)
        أعد هذا.الاسم + " خدّم الطلب رقم " + نص(رقم_الطلب)

الخادم = خادم_ويب("الرئيسي")
اطبع(انتظر الخادم.خدّم(101))
اطبع(انتظر الخادم.خدّم(102))

اطبع("=== ٥) الانتظار المتداخل: خط إنتاج ===")
# دالة غير متزامنة تنتظر أخرى — تركيب المهام كما تركيب الدوال.

غير متزامنة دالة أول(س):
    انتظر_زمن(0.01)
    أعد س * 2

غير متزامنة دالة ثان(س):
    جزء = انتظر أول(س)
    أعد جزء + 10

غير متزامنة دالة ثالث(س):
    جزء = انتظر ثان(س)
    أعد "الحصيلة النهائية: " + نص(جزء)

اطبع(انتظر ثالث(5))

اطبع("=== ٦) أخطاء المهام مع جرب ===")

غير متزامنة دالة املح(الملف):
    انتظر_زمن(0.01)
    لو ليس ملفات.موجود(الملف):
        ارفع استثناء("الملف غير موجود: " + الملف)
    أعد "تم"

مهمة_فاشلة = املح("ملف_غير_موجود.txt")
اطبع("رسالة الفشل: " + مهمة_فاشلة.الخطأ())
جرب:
    انتظر مهمة_فاشلة
باستثناء هـ:
    اطبع("التُقط: " + هـ.رسالة)

اطبع("=== ٧) انتظر تصل للخيوط أيضًا ===")
# كلمة «انتظر» تعمل على خيوط وحدة «خيوط» ومهام غير المتزامن على السواء.

حاصل = خيوط.شغّل(دالة() => جمع([1، 2، 3، 4، 5]))
اطبع("من الخيوط: " + نص(انتظر حاصل))
اطبع("من المهام: " + نص(انتظر اطبخ("الشاي", 1)))
