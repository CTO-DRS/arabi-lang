# =====================================================
#  واجهة السجل (الإصدار 1.22) — استعراض الحزم من المتصفح
# =====================================================
# السجل المجتمعي (1.20) صار له وجه: افتح عنوان الخادم في المتصفح
# تجد لوحة عربية كاملة الاتجاه تعرض الحزم وأحدث نسخها مع مربّع بحث
# فوقها، وصفحة تفاصيل لكل حزمة على /عرض/<اسم> فيها النسخ كلها
# بأحجامها وبصماتها sha256 وأمر التثبيت جاهزًا للنسخ.
#
#   شغل السجل:   arabi حزمة خادم سجلي --منفذ 8000
#   ثم زر:       http://localhost:8000/
#   النص القديم متاح على /ترحيب، ومن يريد سطر الأوامر وحده يضيف
#   --بلا_واجهة فيعود الجذر نصًا كما كان في 1.20 و1.21.
#
# اللوحة كلها بلا أصول خارجية: CSS مدمج في الصفحة ولا جافاسكربت
# ولا خطوط من الشبكة — فتعمل في الشبكات المعزولة كما يعمل الخادم
# نفسه، وكل قيمة قادمة من الحزم مهربة قبل عرضها فلا حزمة تلوّث
# الصفحة. هذا المثال يبني لوحة مصغّرة بنفس الفكرة ويخدمها بخادم
# اللغة ثم يتصفحها بشبكة.اطلب كما يفعل المتصفح تمامًا.

استورد خادم
استورد شبكة

# ---- حزم السجل النموذجي ----

الحزم = [
    {الاسم: "حاسبة"، الوصف: "عمليات حسابية دقيقة"، النسخة: "2.1.0"}،
    {الاسم: "ترحيب"، الوصف: "تحيات وبطاقات عربية"، النسخة: "1.4.0"}،
    {الاسم: "منسق"، الوصف: "تنسيق نصوص وجداول"، النسخة: "0.9.1"}
]

# ---- بناء الصفحات كما يبنيها سجل 1.22 ----

دالة صف_حزمة(حزمة):
    أعد ق"""<tr><td>{حزمة["الاسم"]}</td><td>{حزمة["الوصف"]}</td><td>{حزمة["النسخة"]}</td></tr>"""

دالة جدول(الكلمة):
    صفوف = ""
    لكل حزمة في الحزم:
        لو الكلمة == "" أو الكلمة في حزمة["الاسم"] أو الكلمة في حزمة["الوصف"]:
            صفوف = صفوف + صف_حزمة(حزمة)
    أعد ق"""<p>النتيجة:</p><table>{صفوف}</table>"""

دالة صفحة(العنوان، المحتوى):
    أعد ق"""<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><title>{العنوان}</title></head>
<body>
<h1>سجل عربي المجتمعي</h1>
{المحتوى}
<p>مدعوم بلغة عربي 1.22.0</p>
</body>
</html>"""

# ---- المعالج: / لوحة وبحث، و/عرض/<اسم> تفاصيل حزمة ----

دالة معالج(طلب):
    المسار = طلب["المسار"]
    أجزاء = المسار.قسّم("/")
    لو المسار == "/":
        الكلمة = ""
        لو "بحث" في طلب["المعاملات"].مفاتيح():
            الكلمة = طلب["المعاملات"]["بحث"]
        أعد صفحة("استعراض الحزم"، جدول(الكلمة))
    وإلا إذا (طول(أجزاء) == 3) و (أجزاء[1] == "عرض"):
        الاسم = أجزاء[2]
        لكل حزمة في الحزم:
            لو حزمة["الاسم"] == الاسم:
                أعد صفحة("تفاصيل " + الاسم،
                    ق"""<h2>{حزمة["الاسم"]} <code>{حزمة["النسخة"]}</code></h2>
<p>{حزمة["الوصف"]}</p>
<p>تحميل: <a href="/تحميل/{الاسم}/{حزمة["النسخة"]}">أرشيف النسخة</a></p>""")
        أعد {الحالة: 404، النص: صفحة("خطأ"، "<p>الحزمة " + الاسم + " غير موجودة في السجل</p>")}
    وإلا:
        أعد {الحالة: 404، النص: "الصفحة غير موجودة"}

# ---- تشغيل الخادم والتصفح كما يفعل المتصفح ----

المنفذ = خادم.ابدأ(٠، معالج)
الجذر = "http://127.0.0.1:" + نص(المنفذ)

اللوحة = شبكة.اطلب(الجذر + "/")
اطبع("اللوحة الرئيسية — الحالة:", اللوحة["الحالة"])
اطبع("صفوف الحزم المعروضة:", طول(اللوحة["النص"].قسّم("<tr><td>")) - 1)
اطبع("الصفحة عربية كاملة الاتجاه:", 'dir="rtl"' في اللوحة["النص"])

نتائج_البحث = شبكة.اطلب(الجذر + "/؟بحث=حاسبة")
اطبع("بحث عن «حاسبة» — الحالة:", نتائج_البحث["الحالة"])
اطبع("المطابق ظهر:", "حاسبة" في نتائج_البحث["النص"])
اطبع("غير المطابق اختفى:", "منسق" ليس في نتائج_البحث["النص"])

التفاصيل = شبكة.اطلب(الجذر + "/عرض/حاسبة")
اطبع("تفاصيل حاسبة — الحالة:", التفاصيل["الحالة"])
اطبع("صفحة التفاصيل تعرض النسخة 2.1.0:", "2.1.0" في التفاصيل["النص"])
اطبع("ورابط تحميل الأرشيف جاهز:", "/تحميل/حاسبة/2.1.0" في التفاصيل["النص"])

المفقودة = شبكة.اطلب(الجذر + "/عرض/غائب")
اطبع("حزمة غائبة — الحالة:", المفقودة["الحالة"])
اطبع("برسالة عربية واضحة:", "غير موجودة" في المفقودة["النص"])

خادم.قف()
اطبع("توقف الخادم — هكذا يبدو سجلك في المتصفح: لوحة وبحث وتفاصيل")
