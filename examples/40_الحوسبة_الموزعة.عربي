# الحوسبة الموزعة (الإصدار 1.18) — وحدة «موزعة»
# موزع يستقبل العمالة، وعمالة تخدم المهام، ومهام تنتظرها كما تعرف:
# انتظر / انتظر_الجميع / سباق — والعمل قد ينفذ على أي جهاز في الشبكة.
# ل تشغيل عامل على جهاز آخر: arabi --عامل عنوان_الموزع:7700

من خيوط استورد شغّل
من موزعة استورد موزع، عامل

# ——— مشهد ١: موزع وعامل على الجهاز المحلي ———
م = موزع(0)                        # المنفذ ٠ = اختيار تلقائي من النظام
اطبع("الموزع بدأ على منفذ صحيح:", م.منفذ() > 0)
اطبع("العمالة قبل الاتصال:", م.عمال())

# عاملاً في خيوط (على جهاز آخر يكون الأمر: arabi --عامل المضيف:المنفذ)
خ1 = شغّل(عامل، "127.0.0.1"، م.منفذ())
خ2 = شغّل(عامل، "127.0.0.1"، م.منفذ())

م.انتظر_العمال(2)                  # حجب حتى تكتمل العمالة المطلوبة
اطبع("العمالة بعد الاتصال:", م.عمال())

# ——— مشهد ٢: تقديم مهام وانتظارها ———
دالة جمع(أ، ب):
    أعد أ + ب

دالة مضروب(ن):
    لو ن <= ١:
        أعد ١
    أعد ن * مضروب(ن - ١)           # التعاود يعمل داخل العامل البعيد

ت1 = م.قدّم(جمع، ٢٠، ب=٢٢)         # معاملات بالاسم تعبر الشبكة
ت2 = م.قدّم(مضروب، ٦)
اطبع("جمع بعيد:", انتظر ت1)
اطبع("مضروب بعيد:", انتظر ت2)
اطبع("معرف المهمة الأولى:", ت1.معرف())

# ——— مشهد ٣: انتظر_الجميع بترتيب التقديم بغض النظر عن من نفذ ———
مهام = []
لكل ن في [١، ٢، ٣، ٤، ٥]:
    مهام.أضف(م.قدّم(مضروب، ن))
اطبع("المضروبات:", انتظر_الجميع(مهام))

# ——— مشهد ٤: أخطاء العامل تحتفظ بهويتها عبر الشبكة ———
صنف خطأي من استثناء:
    تجاهل

دالة رفاعي():
    ارفع خطأي("انفجرت المهمة في العامل البعيد")

جرب:
    انتظر م.قدّم(رفاعي)
باستثناء هـ:
    اطبع("أمسكنا خطأ العامل:", هـ)

# ——— مشهد ٥: الكائنات تعبر الشبكة وتعود بطرقها ———
صنف حاسبة:
    دالة إنشاء(بداية):
        هذا.قيمة = بداية
    دالة زد(ن):
        هذا.قيمة = هذا.قيمة + ن
        أعد هذا

دالة يومي(ك):
    ك.زد(٥)
    أعد ك

ك = حاسبة(١٠)                      # كائن يُرمّز ويسافر ويعود
ك2 = انتظر م.قدّم(يومي، ك)
اطبع("الكائن عاد بقيته:", ك2.قيمة)

# ——— مشهد ٦: الإنهاء النظيف — تصفية الجاري ثم وداع العمالة ———
اطبع("عدد المهام المقدمة:", م.حجم())
م.إنهاء()
انتظر خ1
انتظر خ2
اطبع("أغلق الموزع وخرجت العمالة بنظافة")
