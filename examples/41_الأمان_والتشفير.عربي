# الأمان والتشفير (الإصدار 1.19) — وحدة «تشفير»
# بصمات قوية وتوقيع رسائل هوماك ومقارنة زمن ثابت ومفاتيح عشوائية آمنة
# وتشفير كلمات المرور بـ PBKDF2 واشتقاق المفاتيح — ثم إحكام الشبكة
# الموزعة بمفتاح سري: لا عامل يُسجّل إلا بتوقيع التحدي بالمفتاح.

استورد تشفير
من خيوط استورد شغّل
من موزعة استورد موزع، عامل

# ——— مشهد ١: البصمات — صحة البيانات وتغيرها ———
النص = "وحدة تشفير اللغة العربية"
بصمة = تشفير.هش(النص)
اطبع("البصمة 256 طويلة:", طول(بصمة) == 64)
اطبع("تطابق ترميز القديمة:", بصمة == ترميز.هش256(النص))
اطبع("512 أطول:", طول(تشفير.هش512(النص)) == 128)
اطبع("الخوارزميات تعمل:", تشفير.هش(النص، "sha1") == ترميز.هش1(النص))
اطبع("حرف يتغير فتتغير البصمة:",
     تشفير.هش(النص) != تشفير.هش(النص + " "))

# ——— مشهد ٢: توقيع الرسائل هوماك — صحة المصدر والسلامة ———
مفتاح_الرسائل = تشفير.مفتاح_آمن(32)
توقيع = تشفير.هوماك("حوّل ١٠٠٠ ريال للحساب ٤٢"، مفتاح_الرسائل)
اطبع("توقيع أصلي يُقبل:",
     تشفير.مقارنة_آمنة(توقيع، تشفير.هوماك(
         "حوّل ١٠٠٠ ريال للحساب ٤٢"، مفتاح_الرسائل)))
اطبع("رسالة مغشوشة تُكشف:",
     تشفير.مقارنة_آمنة(توقيع، تشفير.هوماك(
         "حوّل ٩٠٠٠ ريال للحساب ٤٢"، مفتاح_الرسائل)) == خطأ)
اطبع("مفتاح مغشوش يُكشف:",
     تشفير.مقارنة_آمنة(توقيع، تشفير.هوماك(
         "حوّل ١٠٠٠ ريال للحساب ٤٢"، تشفير.مفتاح_آمن(32))) == خطأ)

# ——— مشهد ٣: العشوائية الآمنة — مفاتيح لا تُخمَّن ———
م1 = تشفير.مفتاح_آمن()
م2 = تشفير.مفتاح_آمن()
اطبع("مفتاحان مختلفان دائمًا:", م1 != م2)
اطبع("طول مخصص صحيح:", طول(تشفير.مفتاح_آمن(16)) == 32)
اطبع("رمز روابط يعمل:", طول(تشفير.رمز_آمن(16)) >= 20)
ن = تشفير.عدد_آمن(100)
اطبع("عدد آمن في مداه:", ن >= 0 و ن < 100)
اطبع("مدى مزدوج يُحترم:", تشفير.عدد_آمن(50، 60) >= 50)

# ——— مشهد ٤: كلمات المرور — الملح والجولات والبصمة ———
سجل = تشفير.شفر_كلمة("سر_المدير_2025"، 1000)
اطبع("بنية السجل:", سجل["الخوارزمية"] == "pbkdf2_sha256" و
     سجل["الجولات"] == 1000 و طول(سجل["الملح"]) == 32)
اطبع("الكلمة الصحيحة تدخل:", تشفير.تحقق_كلمة("سر_المدير_2025"، سجل))
اطبع("الكلمة الخاطئة تُرفض:",
     تشفير.تحقق_كلمة("سر_المدير_1970"، سجل) == خطأ)
سجل_آخر = تشفير.شفر_كلمة("سر_المدير_2025"، 1000)
اطبع("نفس الكلمة ملحان مختلفان:", سجل["الملح"] != سجل_آخر["الملح"])

# ——— مشهد ٥: اشتقاق المفتاح — من كلمة بشرية إلى مفتاح قنوات ———
سر_مشترك = "قصة عربي وسماء الليل"
مفتاح_قناة = تشفير.مشتق(سر_مشترك، "قناة-الفريق-7700"، 32، 1000)
اطبع("الاشتقاق حتمي:",
     مفتاح_قناة == تشفير.مشتق(سر_مشترك، "قناة-الفريق-7700"، 32، 1000))
اطبع("الملح يغير المفتاح:",
     مفتاح_قناة != تشفير.مشتق(سر_مشترك، "قناة-أخرى-7700"، 32، 1000))
اطبع("الطول المطلوب يعطى:", طول(تشفير.مشتق(سر_مشترك، "م"، 16، 1000)) == 32)

# ——— مشهد ٦: الشبكة الموزعة المحمية — لا عامل بلا توقيع ———
دالة حساب(أ، ب):
    أعد أ * ب + ١

# المفتاح السري يشارك سرًا بين الموزع وعمالته (هنا من مشتق، وهناك
# تشفير.مفتاح_آمن() كافٍ) — والمصادقة بتحدي HMAC-SHA256
مفتاح_الشبكة = تشفير.مشتق(سر_مشترك، "شبكة-الإنتاج"، 32، 1000)
موزع_آمن = موزع(0، "127.0.0.1"، مفتاح_الشبكة)
اطبع("الموزع المحمي بدأ:", موزع_آمن.منفذ() > 0)

عامل_مصدّق = شغّل(عامل، "127.0.0.1"، موزع_آمن.منفذ()، مفتاح_الشبكة)
موزع_آمن.انتظر_العمال(1، 30)
اطبع("عامل موقّع بالتحدي دخل:", موزع_آمن.عمال() == 1)

مهمة = موزع_آمن.قدّم(حساب، 6، 7)
اطبع("عمل بعيد خلف مصادقة:", انتظر مهمة == 43)
موزع_آمن.إنهاء()
انتظر عامل_مصدّق
اطبع("التوزيع المحمي اكتمل بنظافة:", موزع_آمن.عمال() == 0)
