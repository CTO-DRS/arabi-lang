# =====================================================
#  بناء حزمة — بيان حزمة.json + ملفات الكود
# =====================================================
# كل حزمة في سجل الحزم مجلد يحوي:
#   حزمة.json    بيان الحزمة: الاسم (مطلوب) والنسخة والوصف والمدخل
#                والتبعيات {اسم: قيد} مثل ">=1.0.0" أو "^2.0" أو "*"
#   <المدخل>     كود الحزمة بصيغة .عربي
#
# هذا المثال يبني حزمة «تحية» خطوة بخطوة ويعرض بنيتها.
# ملاحظة: اسم الحزمة يجب أن يكون معرفًا صالحًا (حروف وأرقام و_).

استورد نظام
استورد جيسون
استورد ملفات

الجذر = "حزمة_جديدة"

# ١) مجلد الحزمة
نظام.انشاء_مجلد(الجذر)

# ٢) بيان الحزمة
البيان = {
    "الاسم": "تحية",
    "النسخة": "1.0.0",
    "الوصف": "تحيات بالعربية",
    "المدخل": "تحية.عربي",
    "التبعيات": {}
}
ملفات.اكتب(نظام.فصل(الجذر، "حزمة.json")، جيسون.نص(البيان))

# ٣) كود الحزمة — الصياغة يجب أن تكون سليمة، والمدير يرفض الكود المعطوب
الكود = "\"تحيات بالعربية.\"\n\n"
الكود = الكود + "دالة أهلا(الاسم):\n"
الكود = الكود + "    أعد \"أهلاً يا \" + الاسم\n"
ملفات.اكتب(نظام.فصل(الجذر، "تحية.عربي")، الكود)

# ٤) عرض بنية الحزمة الجاهزة للنشر
اطبع("بنية الحزمة " + الجذر + ":")
لكل عنصر في نظام.ملفات_في(الجذر):
    اطبع("  - " + عنصر)
اطبع("")
اطبع("محتوى البيان:")
اطبع(ملفات.اقرأ(نظام.فصل(الجذر، "حزمة.json")))

# ٥) لتجربتها محليًا:
#     python arabi.py حزمة تثبيت حزمة_جديدة
# ولمشاركتها: ارفعها إلى مستودع وسجلها في فهرس arabi-registry
اطبع("لتجربة الحزمة: python arabi.py حزمة تثبيت حزمة_جديدة")

# تنظيف ملفات التجربة — يبقى المجلد فارغًا فقط
ملفات.احذف(نظام.فصل(الجذر، "حزمة.json"))
ملفات.احذف(نظام.فصل(الجذر، "تحية.عربي"))
