# ============================================================
# مثال ٣٨: تجمع الخيوط — تنفيذ الأعمال على عدد محدود من الخيوط
# (الإصدار ١.١٦)
#
# تجمع(عدد) ينشئ تجمعًا يُعاد استخدام خيوطه بدل فتح خيط جديد لكل
# مهمة. قدّم على التجمع تقدّم عملًا وتعيد مهمة — انتظرها بـ انتظر
# أو اجمع نتائجها بـ انتظر_الجميع، وأنهِ التجمع بـ إنهاء().
# ============================================================

اطبع("=== ١) نتائج بترتيبها الأصلي ===")

حسب = دالة(ر) => ر * ر

تج = تجمع(٣)
مهام = []
لكل ر في مدى(١، ٧):
    مهام.أضف(تج.قدّم(حسب، ر))

اطبع("النتائج: " + نص(انتظر_الجميع(مهام)))
اطبع("عدد خيوط التجمع: " + نص(تج.حجم()))

اطبع("")
اطبع("=== ٢) طرق الأصناف وكلمات المفاتيح ===")

صنف محلل:
    دالة إنشاء(زيادة):
        هذا.زيادة = زيادة

    دالة احسب(ر):
        أعد ر + هذا.زيادة

دالة اضرب(أ، ب):
    أعد أ * ب

محلل١ = محلل(١٠٠)
اطبع("طريقة مرتبطة: " + نص(انتظر تج.قدّم(محلل١.احسب، ٧)))
اطبع("كلمات المفاتيح: " + نص(انتظر تج.قدّم(اضرب، ب = ٦، أ = ٧)))

اطبع("")
اطبع("=== ٣) دالة غير متزامنة على التجمع ===")
# الدوال غير المتزامنة تُنفذ على خيوط التجمع أيضًا — الالتزام نفسه

غير متزامنة دالة اطبخ(الاسم):
    انتظر_زمن(0.02)
    أعد "جهّزنا " + الاسم

اطبع(انتظر تج.قدّم(اطبخ، "القهوة"))

اطبع("")
اطبع("=== ٤) حد التزامن محفوظ ===")
# ست مهام على خيطين فقط — لن تعمل أكثر من مهمتين معًا أبدًا

حارس = خيوط.قفل()
نشط = ٠
أقصى = ٠

دالة يعمل(ر):
    عالمي نشط، أقصى
    حارس.احجز()
    نشط = نشط + ١
    لو نشط > أقصى:
        أقصى = نشط
    حارس.افرح()
    انتظر_زمن(0.03)
    حارس.احجز()
    نشط = نشط - ١
    حارس.افرح()
    أعد ر

تج٢ = تجمع(٢)
مهام٢ = []
لكل ر في مدى(٦):
    مهام٢.أضف(تج٢.قدّم(يعمل، ر))
انتظر_الجميع(مهام٢)

لو أقصى <= ٢:
    اطبع("ست مهام على خيطين — لم يُتجاوز الحد أبدًا ✓")
وإلا:
    اطبع("تحذير: تجاوز الحد!")

اطبع("")
اطبع("=== ٥) أخطاء المهام تُحفظ ===")

دالة تفشل(ر):
    لو ر < ٠:
        ارفع استثناء("عدد سالب مرفوض")
    أعد ر * ٢

سليمة = تج.قدّم(تفشل، ٥)
فاشلة = تج.قدّم(تفشل، -٣)
اطبع("نتيجة سليمة: " + نص(انتظر سليمة))
اطبع("رسالة الفشل: " + فاشلة.الخطأ())

جرب:
    انتظر فاشلة
باستثناء هـ:
    اطبع("التُقط عبر انتظر: " + هـ.رسالة)

اطبع("")
اطبع("=== ٦) الإنهاء ===")
# إنهاء() توقف قبول الجديد وتنتظر تصفية كل المقدَّم — مزدوجة الأمان

تج.إنهاء()
تج٢.إنهاء()
تج.إنهاء()

جرب:
    تج.قدّم(حسب، ١)
باستثناء هـ:
    اطبع("التجمع مغلق — رُفض العمل الجديد ✓")

اطبع("")
اطبع("انتهى المثال — كل الأعمال نُفذت على خيوط محدودة الحجم")
