# =====================================================
#  السجل المجتمعي (الإصدار 1.20) — سجل حزم تستضيفه بنفسك
# =====================================================
# سجل الحزم (1.12) يثبت من فهرس مركزي، والسجل المجتمعي يضع الفهرس
# بين يديك: خادم واحد يخدم الفهرس والتنزيل والنشر، بثلاث أوامر:
#
#   ١) شغّل السجل على جهازك أو خادم فريقك:
#        arabi حزمة خادم سجلي --منفذ 8000
#      (وحمِه بمفتاح: أضف --مفتاح سرًا للخادم ولأمر النشر معًا
#       فيصبح لا نشر إلا بتوقيع HMAC-SHA256 على محتوى الحزمة)
#
#   ٢) انشر حزمتك (النسخ غير قابلة للتعديل — مثل السجلات الكبيرة):
#        arabi حزمة نشر حزم/ترحيب --الفهرس http://localhost:8000
#
#   ٣) ثبت من السجل في أي مشروع:
#        arabi حزمة تثبيت ترحيب --الفهرس http://localhost:8000/الفهرس.json
#
# حزمة «ترحيب» هنا في حزم/ كما لو ثبتت توًّا من سجل — والمفسّر
# يجد الحزم المثبتة تلقائيًا، فالاستيراد يعمل بلا أي إعداد.

استورد ترحيب

اطبع(ترحيب.مرحبا("سالم"))
اطبع(ترحيب.توديع("نورة"))
اطبع(ترحيب.بطاقة("الفريق"))

اطبع("")
اطبع("ماذا يمنحك السجل المجتمعي؟")
اطبع("- فهرس قياسي بروتوكول 1.12 نفسه: تثبيت وبحث وتحديث وتبعيات وقفل")
اطبع("- نسخ محفوظة بصمتها وحجمها، والفهرس يعرض الأحدث دومًا")
اطبع("- فحص نحوي لكل حزمة قبل تخزينها — لا ينشر كودًا غير سليم")
