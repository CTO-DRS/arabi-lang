# بروتوكول التكرار المخصص + وحدة الإحصاء (الإصدار 1.10)
# أي صنف يعرّف "تالٍ" يصبح قابلًا للتكرار بـ "لكل" و"في" والنشر "..."

اطبع("=== ١. عداد بسيط بطريقة تالٍ ===")

صنف عداد:
    دالة إنشاء(من، إلى):
        هذا.الحالي = من
        هذا.النهاية = إلى
    دالة تالٍ():
        لو هذا.الحالي > هذا.النهاية:
            أعد ولا شيء          # إشارة انتهاء التكرار
        القيمة = هذا.الحالي
        هذا.الحالي = هذا.الحالي + 1
        أعد القيمة

لكل س في عداد(1، 5):
    اطبع("دورة رقم " + نص(س))

اطبع("")


اطبع("=== ٢. مؤشر منفصل بطريقة أول ===")
# أول() تعيد مؤشرًا جديدًا في كل مرة — فيمكن التكرار أكثر من مرة

صنف قائمة_متسلسلة:
    دالة إنشاء():
        هذا.عناصر = []
        هذا.طولي = 0
    دالة أضف(قيمة):
        هذا.عناصر.أضف(قيمة)
        هذا.طولي = هذا.طولي + 1
    دالة طولي():
        أعد هذا.طولي
    دالة أول():
        أعد مؤشر_قائمة(هذا.عناصر)

صنف مؤشر_قائمة:
    دالة إنشاء(عناصر):
        هذا.عناصر = عناصر
        هذا.موقع = 0
    دالة تالٍ():
        لو هذا.موقع >= طول(هذا.عناصر):
            أعد ولا شيء
        القيمة = هذا.عناصر[هذا.موقع]
        هذا.موقع = هذا.موقع + 1
        أعد القيمة

محفظة = قائمة_متسلسلة()
محفظة.أضف("أسهم")
محفظة.أضف("سندات")
محفظة.أضف("ذهب")

اطبع("المحفظة تحتوي على:")
لكل أصل في محفظة:
    اطبع("  - " + أصل)

# التكرار الثاني يعمل لأن أول() تعيد مؤشرًا جديدًا
عدد_الأصول = 0
لكل أصل في محفظة:
    عدد_الأصول = عدد_الأصول + 1
اطبع("عدد الأصول: " + نص(عدد_الأصول))

اطبع("")


اطبع("=== ٣. عامل في والنشر على الكائنات المخصصة ===")

اطبع("هل السندات في المحفظة؟ " + نص("سندات" في محفظة))
اطبع("هل العقارات في المحفظة؟ " + نص("عقارات" في محفظة))
اطبع("نشر المحفظة في قائمة: " + نص([...محفظة]))

اطبع("")


اطبع("=== ٤. كسر واستمرار داخل التكرار المخصص ===")

مجموع = 0
لكل س في عداد(1، 100):
    لو س > 20:
        كسر
    لو س % 2 == 1:
        استمر
    مجموع = مجموع + س
اطبع("مجموع الأزواج حتى ٢٠: " + نص(مجموع))

اطبع("")


