# ============================================
#  القواميس: أزواج مفتاح / قيمة
# ============================================

# إنشاء قاموس
شخص = {
    "الاسم": "خالد"،
    "العمر": ٣٠،
    "المدينة": "جدة"،
}

# الوصول للقيم
اطبع("الاسم:", شخص["الاسم"])
اطبع("العمر:", شخص["العمر"])

# تعديل قيمة موجودة
شخص["العمر"] = ٣١

# إضافة مفتاح جديد
شخص["الوظيفة"] = "مهندس"
اطبع("بعد التعديل:", شخص)

# المرور على المفاتيح
اطبع("--- بيانات الشخص ---")
لكل مفتاح في شخص:
    اطبع(مفتاح، ":", شخص[مفتاح])

# المرور على المفاتيح والقيم معًا (تفكيك)
لكل مفتاح، قيمة في شخص.عناصر():
    اطبع(مفتاح، "=>", قيمة)

# طرق القواميس
اطبع("المفاتيح:", شخص.مفاتيح())
اطبع("القيم:", شخص.قيم())

# حذف مفتاح
شخص.احذف("الوظيفة")
اطبع("بعد الحذف:", شخص)

# فحص وجود مفتاح
لو "الاسم" في شخص:
    اطبع("الاسم موجود في القاموس")

# قاموس داخل قاموس
فريق = {
    "المدرب": "ناصر"،
    "اللاعبون": ["عمر"، "يوسف"، "سالم"]،
}
اطبع("المدرب:", فريق["المدرب"])
اطبع("أول لاعب:", فريق["اللاعبون"][٠])
