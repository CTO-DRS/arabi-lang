# وحدات الإصدار 1.7: قاعدة (SQLite) — ترميز (Base64 والبصمات) — جداول (CSV)

# ١) قاعدة بيانات SQLite كاملة
استورد قاعدة
استورد ملفات

# نحذف الملف القديم إن وجد — ليكون المثال قابلًا للتكرار
ملفات.احذف("مكتبة_مؤقتة.db")
ملفات.احذف("الكتب.csv")

ق = قاعدة.افتح("مكتبة_مؤقتة.db")

ق.نفذ("""
    CREATE TABLE كتب (
        رقم INTEGER PRIMARY KEY,
        العنوان TEXT,
        المؤلف TEXT,
        السعر REAL
    )
""")

كتب = [
    ["ألف ليلة وليلة"، "مجهول"، 45.5],
    ["البخلاء"، "الجاحظ"، 30],
    ["مقدمة ابن خلدون"، "ابن خلدون"، 60],
]

لكل كتاب في كتب:
    ق.نفذ("INSERT INTO كتب (العنوان, المؤلف, السعر) VALUES (?, ?, ?)"، كتاب)

عدد = ق.نفذ("UPDATE كتب SET السعر = السعر * 0.9 WHERE السعر > 40")
اطبع("خُفّض سعر " + نص(عدد) + " كتب (خصم 10%)")

اطبع("كل الكتب:")
لكل صف في ق.استعلم("SELECT رقم, العنوان, السعر FROM كتب ORDER BY رقم"):
    اطبع("  " + نص(صف[0]) + ". " + صف[1] + " — " + نص(صف[2]) + " ريال")

اطبع("أغلى كتاب: " + ق.استعلم(
    "SELECT العنوان FROM كتب ORDER BY السعر DESC LIMIT 1")[0][0])

أعمدة = ق.أعمدة("SELECT * FROM كتب")
اطبع("أعمدة الجدول: " + نص(أعمدة))

# ٢) الترميز: Base64 والبصمات
استورد ترميز

النص = "لغة عربي للبرمجة"
مشفّر = ترميز.شفّر64(النص)
اطبع("Base64: " + مشفّر)
اطبع("فك الترميز: " + ترميز.فك64(مشفّر))

كلمة_المرور = "سر_خ zajiy213"
اطبع("بصمة SHA-256: " + ترميز.هش256(كلمة_المرور))
اطبع("بصمة MD5: " + ترميز.ام_دي_5("abc"))

# ٣) الجداول CSV: تصدير بيانات القاعدة
استورد جداول

صفوف = [["الرقم"، "العنوان"، "السعر"]]
لكل صف في ق.استعلم("SELECT رقم, العنوان, السعر FROM كتب"):
    صفوف.أضف(صف)

جداول.اكتب("الكتب.csv"، صفوف)
اطبع("صُدّر الملف الكتب.csv")
اطبع("محتواه:")
اطبع(جداول.اقرأ("الكتب.csv"))

# استيراد CSV وتخزينه في القاعدة (فاصل مخصص ؛)
بيانات_خام = "المنتج؛الكمية\nقلم؛100\nكتاب؛45"
منتجات = جداول.حلل(بيانات_خام، "؛")
ق.نفذ("CREATE TABLE منتجات (الاسم TEXT, الكمية INTEGER)")
لكل صف في منتجات[1:]:
    ق.نفذ("INSERT INTO منتجات VALUES (?, ?)"، صف)
اطبع("المنتجات المستوردة: " + نص(ق.استعلم("SELECT * FROM منتجات")))

ق.أغلق()
اطبع("أُغلق اتصال قاعدة البيانات")
