# ============================================
#  متتالية فيبوناتشي — مثال كلاسيكي
#  يوضح الإسناد المتعدد وحلقة طالما
# ============================================

دالة فيبوناتشي(الحجم):
    الأول، الثاني، العداد = ٠، ١، ٠
    النتيجة = []
    طالما العداد < الحجم:
        النتيجة.أضف(الأول)
        الأول، الثاني = الثاني، الأول + الثاني
        العداد += ١
    أعد النتيجة

اطبع("أول ١٠ أعداد في متتالية فيبوناتشي:")
اطبع(فيبوناتشي(١٠))

# نسخة تعاودية (أبطأ لكن أنيقة)
دالة فيب_تعاودي(ن):
    لو ن <= ١:
        أعد ن
    أعد فيب_تعاودي(ن - ١) + فيب_تعاودي(ن - ٢)

اطبع("العدد العاشر تعاوديًا:", فيب_تعاودي(١٠))
