# ============================================
# مثال ١٧: السلاسل المنسقة والنصوص متعددة الأسطر
# ============================================
# البادئة ق (قالب) تحوّل النص إلى قالب تُحقن فيه
# قيم المتغيرات والتعبيرات داخل {أقواس}.

الاسم = "سلمى"
العمر = ٢٥
المدينة = "الرياض"

# حقن متغيرات بسيطة
اطبع(ق"مرحبًا {الاسم}، أهلًا بك في {المدينة}")

# أي تعبير حسابي أو منطقي داخل الأقواس
اطبع(ق"بعد ٥ سنوات سيكون عمرك {العمر + ٥}")
اطبع(ق"هل العمر أكبر من ١٨؟ {العمر > ١٨}")

# استدعاء الدوال والطرق — حتى بعلامات اقتباس متشابهة داخل الأقواس
اطبع(ق"طول الاسم {طول(الاسم)} حرفًا")
اطبع(ق"الاسم بحروف كبيرة: {الاسم.كبير()}")
اطبع(ق"المدينة تبدأ بـ «ال»؟ {المدينة.يبدأ_بـ("ال")}")

# الوصول إلى عناصر القوائم والقواميس مباشرة
درجات = [٩٢, ٨٨, ٩٥]
طالب = {"الاسم": "خالد", "التقدير": "امتياز"}
اطبع(ق"أعلى درجة: {درجات[٢]}")
اطبع(ق"{طالب["الاسم"]} حصل على تقدير {طالب["التقدير"]}")

# ف-نص داخل ف-نص
اطبع(ق"التقدير: {ق"«{طالب["التقدير"]}»"}")

# أقواس حرفية — ضعها مضاعفة {{ هكذا }}
اطبع(ق"القاموس يُكتب هكذا: {{مفتاح: قيمة}}")

# ============================================
# الطرق النصية الجديدة في ١.٤
# ============================================

الجملة = "اللغة العربية جميلة واللغة العربية غنية"

# أوجد — موقع أول ظهور (أو -١ إن لم يوجد)
اطبع(ق"موقع «العربية»: {الجملة.أوجد("العربية")}")
اطبع(ق"موقع «الفرنسية»: {الجملة.أوجد("الفرنسية")}")

# يحتوي — هل النص يتضمن الجزء المطلوب؟
اطبع(ق"هل تحوي «جميلة»؟ {الجملة.يحتوي("جميلة")}")
اطبع(ق"هل تحوي «صعبة»؟ {الجملة.يحتوي("صعبة")}")

# عدد_التكرار — كم مرة ظهرت الكلمة
اطبع(ق"تكرار «اللغة»: {الجملة.عدد_التكرار("اللغة")}")

# اعكس — يعيد النص معكوسًا
اطبع(ق"معكوس كلمة صيف: {"صيف".اعكس()}")

# ============================================
# النصوص متعددة الأسطر — ثلاث علامات اقتباس
# ============================================

الشعار = """لغة عربي:
  لغة برمجة بالعربية الفصحى
  من القلب إلى العالم"""

اطبع(الشعار)
اطبع(ق"طول الشعار {طول(الشعار)} حرفًا و{طول(الشعار.قسّم(" "))} كلمة")

# اقتباسات عادية داخل النص المتعدد بلا هروب
الحوار = """قال المعلم: "من يريد البرمجة؟"
فأجاب الصف: «نحن جميعًا!»"""
اطبع(الحوار)
