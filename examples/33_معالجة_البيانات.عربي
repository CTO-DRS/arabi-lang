# معالجة بيانات بفهم القوائم (الإصدار 1.11)
# سيناريو: سجل مبيعات متجر — ترشيح وتحويل وتجميع وإحصاء
# جرّب أيضًا: python arabi.py --بايت examples/33_معالجة_البيانات.عربي
#             ثم شغّله مرة أخرى — لاحظ سرعة التحميل من الذاكرة

اطبع("=== السجل ===")

# كل عملية: [المدينة، المنتج، الكمية، السعر]
السجل = [
    ["الرياض"، "قهوة"، 3، 12.5]،
    ["جدة"، "شاي"، 2، 9.0]،
    ["الرياض"، "شاي"، 1، 9.0]،
    ["مكة"، "قهوة"، 5، 12.5]،
    ["جدة"، "قهوة"، 2، 12.5]،
    ["الرياض"، "عصير"، 4، 7.25]،
    ["مكة"، "عصير"، 3، 7.25]،
    ["جدة"، "ماء"، 6، 2.0]،
]

# قيمة كل عملية: الكمية × السعر — فهم قائمة مع تفكيك
القيم = [ك * س لكل _مدينة، _منتج، ك، س في السجل]
اطبع("قيم العمليات: " + نص(تقريب(جمع(القيم)، 2)))

اطبع("")

اطبع("=== ١. ترشيح وتحويل ===")

عمليات_الرياض = [عملية لكل عملية في السجل إن عملية[0] == "الرياض"]
اطبع("عمليات الرياض: " + نص(طول(عمليات_الرياض)))

قيمة_الرياض = جمع([عملية[2] * عملية[3] لكل عملية في عمليات_الرياض])
اطبع("قيمتها: " + نص(تقريب(قيمة_الرياض، 2)))

# المنتجات الغالية (سعرها فوق 8) بدون تكرار
المنتجات = [عملية[1] لكل عملية في السجل]
الغالية = []
لكل منتج في المنتجات:
    لو منتج ليس في الغالية:
        لكل عملية في السجل:
            لو عملية[1] == منتج و عملية[3] > 8:
                الغالية.أضف(منتج)
                كسر
اطبع("منتجات سعرها فوق ٨: " + نص(الغالية))

اطبع("")

اطبع("=== ٢. تجميع بفهم قاموس ===")

# إجمالي المبيعات لكل مدينة
المدن = []
لكل عملية في السجل:
    لو عملية[0] ليس في المدن:
        المدن.أضف(عملية[0])

حسب_المدينة = {م: جمع([عملية[2] * عملية[3] لكل عملية في السجل إن عملية[0] == م])
لكل م في المدن}
لكل م في حسب_المدينة:
    اطبع(م + ": " + نص(تقريب(حسب_المدينة[م]، 2)))

اطبع("")

اطبع("=== ٣. إحصاء سريع ===")

اطبع("أغلى عملية: " + نص(أكبر(القيم)))
اطبع("أرخص عملية: " + نص(أصغر(القيم)))
اطبع("متوسط العملية: " + نص(تقريب(إحصاء.معدل(القيم)، 2)))
اطبع("انحراف المعياري: " + نص(تقريب(إحصاء.انحراف(القيم)، 2)))

# ترتيب تنازلي لأعلى ٣ قيم (رتّب تصاعدي ثم عكس بالتقطيع)
أعلى_ثلاث = رتّب(القيم)[::-1][:3]
اطبع("أعلى ٣ عمليات: " + نص(أعلى_ثلاث))

اطبع("")

اطبع("=== ٤. تقرير نهائي بفهم قوائم متداخل ===")

التقرير = [م + " ← " + نص(تقريب(حسب_المدينة[م]، 2)) لكل م في المدن]
لكل سطر في التقرير:
    اطبع("  " + سطر)
