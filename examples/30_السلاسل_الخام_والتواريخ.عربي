# السلاسل الخام ووحدة تواريخ — الإصدار 1.9
# خ"..." سلسلة خام: الشرطة المائلة المعكوسة حرف عادي — مثالية للأنماط النمطية
# وحدة تواريخ: إنشاء التواريخ وقراءتها وفرقها وتنسيقها بأسماء أيام عربية

# ---- مثال ١: لماذا السلاسل الخام؟ ----
# في النص العادي يجب مضاعفة الشرطات، وفي الخام تكتب النمط كما هو
عادي = "س\\ط"          # هنا كتبت شرطتين لتحصل على شرطة
خام = خ"س\ط"           # هنا تكتب شرطة واحدة
اطبع("العادي :", عادي)
اطبع("الخام   :", خام)

# ---- مثال ٢: تنظيم مع السلاسل الخام ----
# أنماط التعبيرات النمطية تزدهر على السلاسل الخام
استورد تنظيم

نص_سجل = "زائر1 دخل 2026-09-25، زائر22 دخل 2026-09-26"
التواريخ = تنظيم.كل_المطابقات(خ"\d{4}-\d{2}-\d{2}"، نص_سجل)
اطبع("التواريخ الموجودة:", التواريخ)

نمط_كلمة = خ"\b\w{5}\b"       # كلمات من ٥ أحرف
اطبع("كلمات ٥ أحرف:", تنظيم.كل_المطابقات(نمط_كلمة، "hello beautiful world"))

# استبدال أرقام عربية بمسافات: النمط خام بلا مضاعفة شرطات
نتيجة = تنظيم.يستبدل(خ"\s+"، " "، "نص    به    مسافات   زائدة")
اطبع("بعد التنظيف:", نتيجة)

# سلسلة خام متعددة الأسطر — مفيدة لقوالب مسارات ويندوز والنصوص الحرفية
مسار = خ"""C:\المستخدمون\أحمد\مستندات"""
اطبع("مسار ويندوز:", مسار)

# ---- مثال ٣: وحدة تواريخ — الإنشاء والقراءة ----
استورد تواريخ

مولد = تواريخ.أنشئ(٢٠٢٦، ٩، ٢٧، ١٠، ٣٠)
اطبع("التاريخ:", مولد)
اطبع("السنة:", مولد.السنة، "الشهر:", مولد.الشهر، "اليوم:", مولد.اليوم)
اطبع("الساعة:", مولد.الساعة، "الدقيقة:", مولد.الدقيقة)
اطبع("اليوم:", مولد.يوم_الأسبوع())

# ---- مثال ٤: التنسيق والتحليل ----
# نسق يحول التاريخ لنص، وحلل يقرأ التاريخ من نص
اطبع("منسق:", مولد.نسق("%Y/%m/%d"))
اطبع("عربي:", مولد.نسق("يوم %d من شهر %m سنة %Y"))

من_نص = تواريخ.حلل("2026-12-01 08:00"، "%Y-%m-%d %H:%M")
اطبع("قُرئ من نص:", من_نص.يوم_الأسبوع()، "الساعة", من_نص.الساعة)

# ---- مثال ٥: الفروق والإضافات ----
بدء = تواريخ.أنشئ(٢٠٢٦، ١، ١)
نهاية = تواريخ.أنشئ(٢٠٢٦، ١، ٣١)
اطبع("أيام يناير:", تواريخ.فرق(نهاية، بدء))

بعد_شهر = تواريخ.أضف(بدء، ٣٠، ١٢)      # ٣٠ يومًا و١٢ ساعة
اطبع("بعد ٣٠ يومًا و١٢ ساعة:", بعد_شهر.نسق("%Y-%m-%d %H:%M"))

# ---- مثال ٦: مطابقة أنماط على التواريخ ----
# تكامل وحدات 1.9: تواريخ + طابق = منطق تقويم أنيق
دالة صف_اليوم(ت):
    طابق ت.يوم_الأسبوع()
    حالة "الخميس" أو "الجمعة" أو "السبت":
        أعد "عطلة نهاية الأسبوع"
    حالة _:
        أعد "يوم عمل"

لكل تاريخ في [تواريخ.أنشئ(٢٠٢٦، ٩، ٢٤)، تواريخ.أنشئ(٢٠٢٦، ٩، ٢٦)]:
    اطبع(تاريخ.نسق("%Y-%m-%d")، "→", صف_اليوم(تاريخ))

# ---- مثال ٧: عدّاد تنازلي لموعد ----
اليوم = تواريخ.أنشئ(٢٠٢٦، ٩، ٢٧)
موعد = تواريخ.أنشئ(٢٠٢٧، ١، ١)
الأيام = تواريخ.فرق(موعد، اليوم)
اطبع("باقي حتى رأس السنة:", الأيام، "يومًا")
