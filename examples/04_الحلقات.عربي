# ============================================
#  الحلقات: لكل، طالما، كسر، استمر
# ============================================

# حلقة "لكل" مع "مدى"
اطبع("--- العد من ١ إلى ٥ ---")
لكل عدد في مدى(١، ٦):
    اطبع("العدد الحالي:", عدد)

# جدول الضرب
اطبع("--- جدول الضرب للعدد ٣ ---")
لكل صف في مدى(١، ٤):
    اطبع(٣، "×"، صف، "="، ٣ * صف)

# حلقة "طالما"
اطبع("--- العد التنازلي ---")
العداد = ٥
طالما العداد > ٠:
    اطبع("العداد:", العداد)
    العداد = العداد - ١

# جملة "كسر" للخروج مبكرًا
اطبع("--- أرقام فردية حتى ٧ ---")
لكل رقم في مدى(١، ٢٠):
    لو رقم > ٧:
        كسر
    لو رقم % ٢ == ٠:
        استمر
    اطبع("رقم فردي:", رقم)

# المرور على عناصر قائمة
اطبع("--- قائمة الفواكه ---")
فواكه = ["تفاح"، "موز"، "برتقال"]
لكل فاكهة في فواكه:
    اطبع("فاكهة:", فاكهة)
