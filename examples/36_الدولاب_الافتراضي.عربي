# ============================================
#  الدولاب الافتراضي — بايت-كود تنفيذي (الإصدار 1.13)
# ============================================
# المفسّر يترجم أجسام الدوال تلقائيًا إلى تعليمات بايت-كود تنفذها
# حلقة دولاب سريعة، وكل جملة أو تعبير استثنائي يعود للممسح الشجري
# فورًا — فالنتائج متطابقة دائمًا مهما كان الكود.
# للتعطيل: python arabi.py --لا-دولاب ملف.عربي

# الحلقات الحسابية أسرع ما تستفيد من الدولاب
دالة مجموع_المربعات(ن):
    مج = 0
    لكل س في مدى(١، ن + ١):
        مج += س * س
    أعد مج

اطبع("مجموع المربعات حتى ١٠٠:", مجموع_المربعات(١٠٠))
اطبع("مجموع المربعات حتى ١٠٠٠٠:", مجموع_المربعات(١٠٠٠٠))

# التعاود يستفيد كذلك: كل استدعاء ينفذ عبر الدولاب
دالة فيب(ن):
    لو ن < ٢:
        أعد ن
    أعد فيب(ن - ١) + فيب(ن - ٢)

اطبع("فيبوناتشي ٢٠:", فيب(٢٠))

# المولدات تعمل كما هي — يديرها الممسح الشجري بشفافية
دالة زوجية(ن):
    لكل س في مدى(ن):
        لو س % ٢ == ٠:
            أنتج س

اطبع("الزوجية حتى ١٠:", [...زوجية(١٠)])

# فهم القوائم والقواميس (مسار احتياط شفاف أيضًا)
اطبع("المكعبات:", [س ** ٣ لكل س في مدى(١، ٦)])
اطبع("مقلوبات:", {س: -س لكل س في مدى(١، ٤)})

# طرق الأصناف تُنفَّذ عبر الدولاب
صنف محفظة:
    دالة إنشاء(الرصيد):
        هذا.الرصيد = الرصيد

    دالة نمِّ(بنسبة):
        هذا.الرصيد = هذا.الرصيد * (١ + بنسبة / ١٠٠)
        أعد هذا.الرصيد

مح = محفظة(١٠٠٠)
اطبع("نمو الرصيد:")
لكل سنة في مدى(١، ٦):
    اطبع("  السنة", سنة, ":", مح.نمِّ(١٠))
اطبع("بلغ الرصيد:", مح.الرصيد)

