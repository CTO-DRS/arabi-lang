# ============================================
#  المولدات: أنتج — قيم تباعًا عند الطلب
# ============================================
# الدالة التي تحوي «أنتج» تعيد مولدًا لا ينفذ فورًا،
# وينتج قيمته واحدة تلو الأخرى (كفاءة في الذاكرة)

# مولد فيبوناتشي اللانهائي المفاهيمي — نوقفه بعد الحد المطلوب
دالة فيبوناتشي(الحد):
    أ = 0
    ب = 1
    لكل س في مدى(الحد):
        أنتج أ
        أ، ب = ب، أ + ب

اطبع("فيبوناتشي (10 حدود):")
سطر = ""
لكل قيمة في فيبوناتشي(10):
    سطر += نص(قيمة) + "، "
اطبع(سطر)

# التكرار مع كسر — المولد يُغلق تلقائيًا عند الخروج
دالة أعداد_كبيرة():
    لكل ن في مدى(1000000):
        أنتج ن

المجموع = 0
لكل ن في أعداد_كبيرة():
    لو ن > 100:
        كسر
    المجموع += ن
اطبع("مجموع 0..100 = " + نص(المجموع))

# تحويل المولد إلى قائمة بالكامل
دالة مضاعفات(الرقم، العدد):
    لكل س في مدى(1، العدد + 1):
        أنتج الرقم * س

القائمة = قائمة(مضاعفات(7، 6))
اطبع("مضاعفات 7: " + نص(القائمة))

# المرشّح مع مولد: الأعداد الزوجية فقط
دالة زوجية(ق):
    أعد ق % 2 == 0

زوجيات = مرشّح(زوجية، فيبوناتشي(15))
اطبع("فيبوناتشي الزوجية: " + نص(زوجيات))

# التقدم اليدوي بالطريقة التالي()
دالة تحية_متفاوتة():
    أنتج "مرحبا"
    أنتج "أهلا"
    أنتج "سلام"

م = تحية_متفاوتة()
اطبع("التالي: " + م.التالي())
اطبع("التالي: " + م.التالي())

# المولد كطريقة صنف: تكرار على سجلات
صنف سجل_درجات:
    دالة إنشاء(أسماء، درجات):
        هذا.أسماء = أسماء
        هذا.درجات = درجات

    خاصية الناجحون:
        أعد مرشّح(دالة(الدرجة) => الدرجة >= 60، هذا.درجات)

    دالة أزواج():
        لكل س في مدى(طول(هذا.أسماء)):
            أنتج [هذا.أسماء[س]، هذا.درجات[س]]

سجل = سجل_درجات(["سارة"، "أحمد"، "نورة"]، [90، 55، 78])
اطبع("الناجحون: " + نص(سجل.الناجحون))
اطبع("السجلات:")
لكل زوج في سجل.أزواج():
    اطبع("  " + زوج[0] + ": " + نص(زوج[1]))
