# الميزات المتقدمة في لغة عربي — الإصدار 1.5
# التعبير الثلاثي، تعداد، خاصية، تحميل العوامل، عالمي، تحقق، احذف

# ---- التعبير الثلاثي: لو شرط: قيمة وإلا قيمة ----
درجة_الحرارة = ٤٢
الحالة = لو درجة_الحرارة > ٤٠: "حار جدًا" وإلا "معتدل"
اطبع("الطقس: " + الحالة)

# ---- التعداد: مجموعة ثوابت مسماة ----
تعداد أولوية:
    منخفضة
    عادية
    عالية = ١٠
    حرجة

مهمة = أولوية.عالية
اطبع("أولوية المهمة: " + مهمة.الاسم)
اطبع("رقمها: " + نص(مهمة.القيمة))

لو مهمة == أولوية.عالية:
    اطبع("المهمة تحتاج انتباهًا عاليًا")

# ---- الخاصية المحسوبة: تُقرأ بلا أقواس وتُحسب عند الطلب ----
صنف دائرة:
    دالة إنشاء(نق):
        هذا.نق = نق

    خاصية المساحة:
        أعد ٣.١٤١٥٩ * هذا.نق * هذا.نق

    خاصية الوصف:
        أعد ق"دائرة نصف قطرها {هذا.نق} ومساحتها {هذا.المساحة} وحدة"

ص = دائرة(٣)
اطبع(ص.الوصف)

# ---- تحميل العوامل: كائناتك تدعم + و - و == ----
صنف نقطة:
    دالة إنشاء(س، ص):
        هذا.س = س
        هذا.ص = ص

    دالة اجمع(أخرى):
        أعد نقطة(هذا.س + أخرى.س، هذا.ص + أخرى.ص)

    دالة اطرح(أخرى):
        أعد نقطة(هذا.س - أخرى.س، هذا.ص - أخرى.ص)

    دالة يساوي(أخرى):
        أعد هذا.س == أخرى.س و هذا.ص == أخرى.ص

    دالة نص():
        أعد ق"({هذا.س}، {هذا.ص})"

م = نقطة(٢، ٣) + نقطة(١٠، ٢٠)
اطبع("المجموع: " + نص(م))
اطبع("الفرق: " + نص(نقطة(١٠، ٢٠) - نقطة(١، ٢)))
اطبع("متساويتان؟ " + نص(نقطة(١، ١) == نقطة(١، ١)))

# ---- عالمي: تعديل المتغير العام من داخل دالة ----
عدد_الزيارات = ٠

دالة سجل_زيارة():
    عالمي عدد_الزيارات
    عدد_الزيارات += ١

سجل_زيارة()
سجل_زيارة()
سجل_زيارة()
اطبع("عدد الزيارات: " + نص(عدد_الزيارات))

# ---- تحقق: ضمان صحفية البيانات ----
دالة سحب(الرصيد، المبلغ):
    تحقق المبلغ > ٠، "المبلغ يجب أن يكون موجبًا"
    تحقق المبلغ <= الرصيد، "الرصيد غير كافٍ"
    أعد الرصيد - المبلغ

اطبع("الرصيد بعد السحب: " + نص(سحب(١٠٠٠، ٣٠٠)))

جرب:
    سحب(١٠٠، -٥)
باستثناء هـ:
    اطبع("رفض العملية: " + هـ)

# ---- احذف: متغير أو عنصر أو مفتاح ----
قائمة_مهام = ["شراء", "برمجة", "قراءة"]
احذف قائمة_مهام[١]
اطبع("بعد الحذف: " + نص(قائمة_مهام))

بيانات = {"الاسم": "ليلى", "المدينة": "جدة"}
احذف بيانات["المدينة"]
اطبع("البيانات: " + نص(بيانات))
