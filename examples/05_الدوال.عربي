# ============================================
#  الدوال: التعريف، الإرجاع، التعاود
# ============================================

# دالة بسيطة بلا إرجاع
دالة ترحيب(الاسم):
    اطبع("مرحبا", الاسم + "!")

ترحيب("أحمد")
ترحيب("فاطمة")

# دالة تعيد قيمة
دالة مساحة_المستطيل(العرض، الارتفاع):
    أعد العرض * الارتفاع

المساحة = مساحة_المستطيل(٥، ٨)
اطبع("مساحة المستطيل:", المساحة)

# دالة بعدة معاملات
دالة معدل_الدرجات(الرياضيات، العلوم، العربية):
    المجموع = الرياضيات + العلوم + العربية
    أعد المجموع / ٣

اطبع("المعدل:", معدل_الدرجات(٩٠، ٨٥، ٩٥))

# التعاود: الدالة تستدعي نفسها
دالة مضروب(ن):
    لو ن <= ١:
        أعد ١
    أعد ن * مضروب(ن - ١)

اطبع("مضروب ٥ =", مضروب(٥))
اطبع("مضروب ١٠ =", مضروب(١٠))

# الإغلاق (Closure): دالة داخل دالة تتذكر نطاقها
دالة عداد():
    العدد = ٠
    دالة زد():
        العدد = العدد + ١
        أعد العدد
    أعد زد

الخطوة = عداد()
اطبع("استدعاء أول:", الخطوة())
اطبع("استدعاء ثانٍ:", الخطوة())
اطبع("استدعاء ثالث:", الخطوة())
