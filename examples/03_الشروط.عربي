# ============================================
#  جمل الشروط: لو، وإلا إذا، وإلا
# ============================================

الدرجة = ٨٥

لو الدرجة >= ٩٠:
    اطبع("ممتاز! تقدير أ")
وإلا إذا الدرجة >= ٨٠:
    اطبع("جيد جدًا! تقدير ب")
وإلا إذا الدرجة >= ٧٠:
    اطبع("جيد! تقدير ج")
وإلا:
    اطبع("حاول مرة أخرى")

# الشروط المركبة باستخدام "و" و "أو"
العمر = ٢٠
لو العمر >= ١٨ و العمر < ٦٠:
    اطبع("يمكنك الحصول على رخصة قيادة")

الرقم = ٧
لو الرقم < ٠ أو الرقم > ١٠٠:
    اطبع("الرقم خارج المدى المسموح")
وإلا:
    اطبع("الرقم داخل المدى المسموح")

# عامل "ليس" و "في"
فواكه = ["تفاح"، "موز"]
لو "تفاح" في فواكه:
    اطبع("نعم، التفاح موجود في السلة")

لو "عنب" ليس في فواكه:
    اطبع("العنب غير موجود في السلة")
