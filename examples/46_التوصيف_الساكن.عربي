# ============================================
#  التوصيف الساكن — عقود الدوال تُفحص قبل التشغيل (1.36)
# ============================================
# التوصيف الاختياري (1.26) يفحص وقت التشغيل عند أول استدعاء،
# والفحص الساكن (--تحقق-ساكن) يفحص العقود نفسها من المصدر وحده:
# أسماء الأنواع، ومسارات أعد ذات الأدلة الحرفية، والسقوط الضمني.
# هذا المثال المثال الرسمي لبوابة CI — يجب أن يمر الفحص دائمًا.

# عقود قوائم: قائمة[عدد] تعني كل عنصر عدد
دالة مجموع_القيم(قيم: قائمة[عدد]) → عدد:
    المجموع = 0
    لكل قيمة في قيم:
        المجموع = المجموع + قيمة
    أعد المجموع

# عقد نص: وسيط نص وقيمة إرجاع نص (نص منسق = دليل نص ساكن)
دالة رحّب(اسم: نص) → نص:
    أعد ق"أهلًا {اسم} — تعلم البرمجة بالعربية"

# دالة التحويل المدمجة تعطي دليل ساكن: عدد(...) تعطي عددًا
دالة إلى_عدد(نص_رقم: نص) → عدد:
    أعد عدد(نص_رقم) * 2

# صحيح يمر لعقد عدد (برج PEP 484 — ق١٥ من المواصفة)
دالة مربع(ن: صحيح) → عدد:
    أعد ن * ن

# صنف كنوع: قائمة[نقطة] قائمة كائنات، والإرجاع كائن صنف
صنف نقطة:
    دالة إنشاء(س، ص):
        هذا.س = س
        هذا.ص = ص
    دالة مسافة_مربع():
        أعد هذا.س * هذا.س + هذا.ص * هذا.ص

دالة أصنع_نقطة(س، ص) → نقطة:
    أعد نقطة(س، ص)

# عدم: دالة تعرض ولا تعيد قيمة
دالة اطبع_الفاصل() → عدم:
    اطبع("================")

# ===== تجربة العقود =====
اطبع(مجموع_القيم([1، 2، 3، 4، 5]))
اطبع(رحّب("مطور"))
اطبع(إلى_عدد("21"))
اطبع(مربع(7))
ن = أصنع_نقطة(3، 4)
اطبع("المسافة المربعة:"، ن.مسافة_مربع())
اطبع_الفاصل()
اطبع("الفحص الساكن: كل العقود أعلاه مفحوصة قبل التشغيل")
