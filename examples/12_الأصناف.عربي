# البرمجة الكائنية في لغة عربي
# صنف = قالب للكائنات، هذا = الكائن الحالي، من = الوراثة، الأصل = الصنف الأب

صنف حساب:
    دالة إنشاء(صاحب، رصيد):
        هذا.صاحب = صاحب
        هذا.رصيد = رصيد

    دالة إيداع(مبلغ):
        هذا.رصيد += مبلغ
        أعد هذا.رصيد

    دالة سحب(مبلغ):
        لو مبلغ > هذا.رصيد:
            ارفع("الرصيد غير كافٍ للسحب")
        هذا.رصيد -= مبلغ
        أعد هذا.رصيد

    دالة عرض():
        أعد هذا.صاحب + ": " + نص(هذا.رصيد) + " ريال"

# حساب_توفير يرث كل طرق حساب، ويضيف مميزات جديدة
صنف حساب_توفير من حساب:
    معدل_الربح = 5

    دالة إنشاء(صاحب، رصيد):
        الأصل.إنشاء(هذا، صاحب، رصيد)
        هذا.مكافآت = 0

    دالة إيداع(مبلغ):
        هذا.مكافآت += 1
        أعد الأصل.إيداع(هذا، مبلغ)

    دالة عرض():
        أعد "حساب توفير — " + الأصل.عرض(هذا) + " (مكافآت: " + نص(هذا.مكافآت) + ")"

# ---- تجربة الصنف الأول ----
ح = حساب("سارة"، 100)
ح.إيداع(50)
اطبع(ح.عرض())
ح.سحب(30)
اطبع(ح.عرض())

# ---- تجربة الصنف الوارث ----
ت = حساب_توفير("خالد"، 200)
ت.إيداع(100)
اطبع(ت.عرض())
اطبع("معدل الربح السنوي:", حساب_توفير.معدل_الربح، "%")

# ---- معالجة خطأ السحب فوق الرصيد ----
جرب:
    ح.سحب(10000)
باستثناء:
    اطبع("تم رفض عملية السحب كما هو متوقع")
