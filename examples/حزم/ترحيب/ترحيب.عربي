# حزمة «ترحيب» — نموذج حزمة للسجل المجتمعي (الإصدار 1.20)
# هذه الحزمة موجودة هنا كما تظهر بعد تثبيتها من سجل مجتمعي:
#   arabi حزمة خادم سجلي --منفذ 8000
#   arabi حزمة نشر حزم/ترحيب --الفهرس http://localhost:8000
#   arabi حزمة تثبيت ترحيب --الفهرس http://localhost:8000/الفهرس.json

دالة مرحبا(اسم):
    أعد "أهلًا وسهلًا يا " + اسم + "، نورت المجلس"

دالة توديع(اسم):
    أعد "مع السلامة يا " + اسم + "، في لقاء قريب"

دالة بطاقة(اسم):
    أعد "【 " + مرحبا(اسم) + " 】"
