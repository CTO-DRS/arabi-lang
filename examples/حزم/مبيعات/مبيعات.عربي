"عمليات المبيعات وتقاريرها — حزمة نموذجية لسجل الحزم."

دالة الإجمالي(المبالغ):
    س = 0
    لكل م في المبالغ:
        س = س + م
    أعد س

دالة المتوسط(المبالغ):
    لو طول(المبالغ) == 0:
        أعد 0
    أعد الإجمالي(المبالغ) / طول(المبالغ)

دالة الأعلى(المبالغ):
    أكبر_قيمة = المبالغ[0]
    لكل م في المبالغ:
        لو م > أكبر_قيمة:
            أكبر_قيمة = م
    أعد أكبر_قيمة

دالة تقرير(الشهور، المبالغ):
    الأسطر = ["تقرير المبيعات"]
    لكل رقم في مدى(طول(الشهور)):
        الأسطر.أضف("  " + الشهور[رقم] + ": " + نص(المبالغ[رقم]))
    الأسطر.أضف("الإجمالي: " + نص(الإجمالي(المبالغ)))
    الأسطر.أضف("المتوسط: " + نص(المتوسط(المبالغ)))
    الأسطر.أضف("الأعلى: " + نص(الأعلى(المبالغ)))
    أعد الأسطر
