#  القوائم: الإنشاء، الفهرسة، التقطيع، الطرق
# ============================================

# إنشاء قائمة
فواكه = ["تفاح"، "موز"، "برتقال"، "عنب"]

# الوصول بالفهرس (يبدأ من ٠، والسالب يعد من النهاية)
اطبع("أول فاكهة:", فواكه[٠])
اطبع("ثاني فاكهة:", فواكه[١])
اطبع("آخر فاكهة:", فواكه[-١])
اطبع("عدد الفواكه:", طول(فواكه))

# طرق القوائم
فواكه.أضف("مانجو")
اطبع("بعد الإضافة:", فواكه)

فواكه.أزل("موز")
اطبع("بعد الحذف:", فواكه)

# التقطيع: القائمة[البداية:النهاية:الخطوة]
أرقام = [٠، ١، ٢، ٣، ٤، ٥، ٦، ٧، ٨، ٩]
اطبع("العناصر كلها:", أرقام)
اطبع("من ٢ إلى ٥:", أرقام[٢:٦])
اطبع("آخر ٣ عناصر:", أرقام[-٣:])
اطبع("الأعداد الزوجية:", أرقام[::٢])
اطبع("القائمة المعكوسة:", أرقام[::-١])

# تعديل عنصر بالفهرس
أرقام[٠] = ١٠٠
اطبع("بعد تعديل أول عنصر:", أرقام)

# دوال جاهزة مفيدة
درجات = [٧٨، ٩٢، ٦٥، ٨٨، ٧٠]
اطبع("أعلى درجة:", أكبر(درجات))
اطبع("أقل درجة:", أصغر(درجات))
اطبع("مجموع الدرجات:", جمع(درجات))
اطبع("الدرجات مرتبة:", رتّب(درجات))

# البحث داخل قائمة
لو ٩٢ في درجات:
    اطبع("الدرجة ٩٢ موجودة")

# قائمة داخل قائمة (مصفوفة)
لوحة = [
    [١، ٢، ٣]،
    [٤، ٥، ٦]،
    [٧، ٨، ٩]،
]
اطبع("العنصر في الصف الثاني والعمود الثالث:", لوحة[١][٢])
