# وحدة خيوط — التنفيذ المتوازي بذاكرة مشتركة — الإصدار ١.٨
# خيوط.شغّل(دالة، وسائط...) يشغل دالة عربية في خيط مستقل ويعيد خيطًا
# خيوط.قفل() يحمي البيانات المشتركة — خيوط.طابور() ينقل الرسائل بين الخيوط

# ─── ١) تشغيل أساسي: نتيجة() تنتظر وتعيد قيمة الدالة ───

دالة تحليل(اسم، ثوان):
    وقت.نوم(٠.٠٥ * ثوان)
    أعد اسم + " اكتمل بعد " + نص(ثوان) + " جولات"

بداية = وقت.زمن()
خ١ = خيوط.شغّل(تحليل، "المهمة أ"، ٢)
خ٢ = خيوط.شغّل(تحليل، "المهمة ب"، ٣)

اطبع(خ١.نتيجة())
اطبع(خ٢.نتيجة())
اطبع("بالتوازي: " + نص(وقت.زمن() - بداية) + " ثانية تقريبًا")

# ─── ٢) انتظر_الكل: شغّل دفعة مهام واجمع النتائج ───

دالة مربع(س):
    أعد س * س

مهام = []
لكل س في مدى(١، ٦):
    مهام.أضف(خيوط.شغّل(مربع، س))

نتائج = خيوط.انتظر_الكل(مهام)
اطبع("المربعات: " + نص(نتائج))

# ─── ٣) ذاكرة مشتركة محمية بقفل: عداد آمن ───
# بلا قفل قد تفقد الزيادات — القفل يجعل الزيادة ذرية

العداد = ٠
الحارس = خيوط.قفل()

دالة زد(مرات):
    عالمي العداد
    تم = ٠
    طالما تم < مرات:
        الحارس.احجز()
        العداد += ١
        الحارس.افرح()
        تم += ١

عاملون = []
لكل دفعة في [١٠٠، ٢٠٠، ٣٠٠، ٤٠٠]:
    عاملون.أضف(خيوط.شغّل(زد، دفعة))

خيوط.انتظر_الكل(عاملون)
اطبع("العداد النهائي (متوقع ١٠٠٠): " + نص(العداد))

# ─── ٤) الطابور: نمط المنتج والمستهلك ───

صندوق = خيوط.طابور()

دالة منتج():
    لكل س في مدى(٥):
        صندوق.أرسل("قطعة-" + نص(س))
    اطبع("المنتج: أرسلت كل القطع")

دالة مستهلك():
    مستلمة = []
    طالما طول(مستلمة) < ٥:
        مستلمة.أضف(صندوق.استلم())
    أعد مستلمة

خيوط.شغّل(منتج).انتظر()
ص = خيوط.شغّل(مستهلك)
اطبع("المستهلك استلم: " + نص(ص.نتيجة()))
اطبع("الصندوق فارغ؟ " + نص(صندوق.فارغ()))

# ─── ٥) الأخطاء داخل الخيوط لا تختفي ───

دالة خطرة(س):
    لو س == ٠:
        ارفع("القسمة على صفر قادمة")
    أعد ١٠٠ / س

جرب:
    خيوط.شغّل(خطرة، ٠).نتيجة()
باستثناء هـ:
    اطبع("التُقط من الخيط: " + هـ)

اطبع("محاولة سليمة: " + نص(خيوط.شغّل(خطرة، ٤).نتيجة()))
