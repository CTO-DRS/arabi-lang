# التشفير الكامل (الإصدار 1.21) — البيانات العابرة لم تعد مقروءة
# شفرة انسيابية بتيار HMAC-SHA256 في نمط العدّاد موقّعة Encrypt-then-MAC:
# تشفير.شفّر/تشفير.فكّ للنصوص داخل البرنامج — وكل أعمال الشبكة الموزعة
# ونتائجها تُشفَّر تلقائيًا بعد المصافحة متى كان للموزع مفتاح سري.

استورد تشفير
من خيوط استورد شغّل
من موزعة استورد موزع، عامل

# ——— مشهد ١: شفّر وفكّ — الخزنة الشخصية ———
سر = "كلمات فتح الخزنة: الفجر يكشف ما أخفى الليل"
مشفّر = تشفير.شفّر(سر، "مفتاح_الخزنة_٤٢")
اطبع("المشفر ستر عشري:", طول(مشفّر) > 0 و مشفّر != سر)
اطبع("لا نص سرية ظاهر:", "الخزنة" != مشفّر)
اطبع("الفك بالمفتاح الصحيح يعيد الأصل:",
     تشفير.فكّ(مشفّر، "مفتاح_الخزنة_٤٢") == سر)

# كل نداء شفّر يولّد راوندًا عشوائيًا — المشفران يختلفان والنص واحد
مشفّر_ثاني = تشفير.شفّر(سر، "مفتاح_الخزنة_٤٢")
اطبع("مشفران لنص واحد مختلفان:", مشفّر_ثاني != مشفّر)
اطبع("وكلاهما يفك إلى النص نفسه:",
     تشفير.فكّ(مشفّر_ثاني، "مفتاح_الخزنة_٤٢") == سر)

# ——— مشهد ٢: المفتاح الخاطئ والتلاعب — لا صمت أمني ———
جرب:
    تشفير.فكّ(مشفّر، "مفتاح_مغشوش")
    اطبع("لن يُطبع هذا")
باستثناء:
    اطبع("مفتاح خاطئ رُفض: فشل التحقق قبل فك أي بايت")

# بايت واحد معدل في الستر يُكشف فورًا بالبصمة — والتغيير حتمي مضمون
وسط = مشفّر[30]
بديل = "0"
لو وسط == "0":
    بديل = "f"
معدول = مشفّر[0:30] + بديل + مشفّر[31:]
اطبع("التعديل فعلًا وقع:", معدول != مشفّر)
جرب:
    تشفير.فكّ(معدول، "مفتاح_الخزنة_٤٢")
باستثناء:
    اطبع("تعديل بايت واحد يفضح نفسه بالبصمة")

# ——— مشهد ٣: السجل المشفر — قائمة أسرار تُخزَّن آمنة ———
سجل_الأسعار = {
    "القهوة": "طلبية المورد لا تتجاوز ١٠٠٠"،
    "النقل": "مسار التوصيل الجديد عبر الوادي"،
    "العقود": "تجديد اتفاقية الربع القادم شهران",
}
مفتاح_السجل = تشفير.مفتاح_آمن(32)
سجل_مشفّر = {}
لكل مفتاح في سجل_الأسعار:
    سجل_مشفّر[مفتاح] = تشفير.شفّر(سجل_الأسعار[مفتاح]، مفتاح_السجل)

سلامة = صح
لكل مفتاح في سجل_مشفّر:
    لو تشفير.فكّ(سجل_مشفّر[مفتاح]، مفتاح_السجل) != سجل_الأسعار[مفتاح]:
        سلامة = خطأ
اطبع("السجل المشفر يدور ويصح:", سلامة و طول(سجل_مشفّر) == 3)

# ——— مشهد ٤: الشبكة الموزعة المشفرة — أعمال لا يفهمها تنصّت ———
دالة تحليل(أ، ب):
    أعد أ * 100 + ب

# مفتاح واحد مشترك بين الموزع وعمالته — مصادقة بالتحدي (1.19)
# ثم تشفير كامل لكل أعمال العمالة ونتائجها (1.21)
مفتاح_الشبكة = تشفير.مشتق("سر الفريق الصناعي"، "شبكة-مشفرة-7700"، 32، 1000)
موزع_مشفّر = موزع(0، "127.0.0.1"، مفتاح_الشبكة)
اطبع("قناة الموزع مشفرة:", موزع_مشفّر.مشفّر())

عامل_مشفّر = شغّل(عامل، "127.0.0.1"، موزع_مشفّر.منفذ()، مفتاح_الشبكة)
موزع_مشفّر.انتظر_العمال(1، 30)
اطبع("عامل مشفر اتصل بالمصافحة:", موزع_مشفّر.عمال() == 1)

مهمة = موزع_مشفّر.قدّم(تحليل، 4، 2)
اطبع("عمل بعيد عبر قناة مشفرة:", انتظر مهمة == 402)
موزع_مشفّر.إنهاء()
انتظر عامل_مشفّر
اطبع("الجلسة المشفرة أُغلقت بنظافة:", موزع_مشفّر.عمال() == 0)
