اطبع("=== ٢. الترشيح: إن شرط ===")

زوجية = [س لكل س في مدى(1، 21) إن س % 2 == 0]
اطبع("زوجية من 1 إلى 20: " + نص(زوجية))

الكلمات = ["تفاح"، "تمر"، "عنب"، "تين"، "رمان"]
طويلة = [ك لكل ك في الكلمات إن طول(ك) > 3]
اطبع("كلمات بأكثر من ٣ أحرف: " + نص(طويلة))

اطبع("")

اطبع("=== ٣. التحويل والترشيح معًا ===")

# مبيعات أكبر من 100 مع زيادتها 10٪
المبيعات = [50، 120، 200، 80، 300]
مرفوعة = [م * 1.1 لكل م في المبيعات إن م > 100]
اطبع(مرفوعة)

اطبع("")

اطبع("=== ٤. التفكيك: أهداف مزدوجة ===")

نقاط = [[1، 2]، [3، 4]، [5، 6]]
المجاميع = [أ + ب لكل أ، ب في نقاط]
اطبع("مجاميع الإحداثيات: " + نص(المجاميع))

المسافات = [أ * أ + ب * ب لكل أ، ب في نقاط إن أ + ب > 6]
اطبع("مربعات المسافة لمن تجاوز مجموعه ٦: " + نص(المسافات))

اطبع("")

اطبع("=== ٥. عبارات لكل متتالية (ضرب ديكارتي) ===")

ملابس = [[ل، ب] لكل ل في ["أحمر"، "أزرق"] لكل ب في ["قميص"، "بنطال"]]
لكل عنصر في ملابس:
    اطبع(عنصر[0] + " / " + عنصر[1])

