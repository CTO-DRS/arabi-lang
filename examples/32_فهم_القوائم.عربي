اطبع("=== ٨. دمج أدوات اللغة: فهم + اختزل ===")

درجات = [85، 92، 78، 95، 60]
المجتازون = [د لكل د في درجات إن د >= 80]
المتوسط = جمع(المجتازون) / طول(المجتازون)
اطبع("المجتازون: " + نص(المجتازون))
اطبع("متوسطهم: " + نص(تقريب(المتوسط، 2)))
