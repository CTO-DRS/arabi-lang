اطبع("=== ٦. فهم القاموس ===")

أسماء = ["أحمد"، "سارة"، "خالد"]
أطوال = {ن: طول(ن) لكل ن في أسماء}
اطبع(أطوال)

مربعات_فردية = {س: س * س لكل س في مدى(10) إن س % 2 == 1}
اطبع("مربعات الفردية: " + نص(مربعات_فردية))

# فهم قاموس مقلوب: من قيمة إلى مفتاح (عناصر() تعيد أزواجًا للتفكيك)
سكان = {"الرياض": 7، "جدة": 4، "مكة": 2}
بالمقلوب = {ق: م لكل م، ق في سكان.عناصر()}
اطبع("مقلوب القاموس: " + نص(بالمقلوب))

اطبع("")

اطبع("=== ٧. فهم متداخل: مصفوفة منقولة ===")

مصفوفة = [[1، 2، 3]، [4، 5، 6]]
منقولة = [[صف[عمود] لكل صف في مصفوفة] لكل عمود في مدى(3)]
لكل صف في منقولة:
    اطبع(نص(صف))

