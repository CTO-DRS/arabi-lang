# ============================================
#  خادم ويب حقيقي بلغة عربي — وحدة خادم
#  يبدأ الخادم، يخدم صفحة وواجهة API، ثم يتوقف
# ============================================

استورد خادم
استورد شبكة

# ---- دالة المعالجة: تستقبل الطلب وتعيد الاستجابة ----
# الطلب قاموس: {الطريقة، المسار، المعاملات، الترويسات، النص}
# الاستجابة نص صفحة، أو قاموس {الحالة، النص، الترويسات}

دالة معالج(طلب):
    المسار = طلب["المسار"]

    # صفحة رئيسية عربية
    لو المسار == "/":
        أعد ق"""<html dir="rtl">
  <body>
    <h1>مرحبا من خادم لغة عربي!</h1>
    <p>الطريقة: {طلب["الطريقة"]}</p>
  </body>
</html>"""

    # واجهة API: تحية باسم من معاملات الاستعلام
    وإلا إذا المسار == "/تحية":
        الاسم = طلب["المعاملات"]["الاسم"]
        أعد {الحالة: 200، النص: ق"أهلا بك يا {الاسم}!"}

    # واجهة API: جمع رقمين ممرين بالمسار
    وإلا إذا المسار == "/جمع":
        أ = عدد(طلب["المعاملات"]["أ"])
        ب = عدد(طلب["المعاملات"]["ب"])
        أعد {الحالة: 200، النص: نص(أ + ب)}

    # ما لم يُعرف: خطأ ٤٠٤
    وإلا:
        أعد {الحالة: 404، النص: "الصفحة غير موجودة"}

# ---- تشغيل الخادم على منفذ تلقائي (٠ = اختر منفذًا متاحًا) ----

المنفذ = خادم.ابدأ(٠، معالج)
اطبع("الخادم يعمل على المنفذ:", المنفذ)

# ---- استدعاء الخادم من نفس البرنامج للتجربة ----

الرئيسية = شبكة.اطلب("http://127.0.0.1:" + نص(المنفذ) + "/")
اطبع("الصفحة الرئيسية — الحالة:", الرئيسية["الحالة"])

التحية = شبكة.اطلب("http://127.0.0.1:" + نص(المنفذ) + "/تحية؟الاسم=أحمد")
اطبع("واجهة التحية:", التحية["النص"])

الجمع = شبكة.اطلب("http://127.0.0.1:" + نص(المنفذ) + "/جمع؟أ=١٢&ب=٣٠")
اطبع("واجهة الجمع: ١٢ + ٣٠ =", الجمع["النص"])

المفقودة = شبكة.اطلب("http://127.0.0.1:" + نص(المنفذ) + "/غير_موجودة")
اطبع("صفحة مفقودة — الحالة:", المفقودة["الحالة"])

# ---- إيقاف الخادم وتحرير المنفذ ----

خادم.قف()
اطبع("توقف الخادم بنجاح")

