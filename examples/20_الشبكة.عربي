# وحدة شبكة — طلبات HTTP من لغة عربي مباشرة
# ملاحظة: يتطلب هذا الملف اتصالاً بالإنترنت، وكل طلب محمي بـ جرب

# ---- طلب GET بسيط ----
جرب:
    استجابة = شبكة.اطلب("https://example.com"، "GET"، {}، ولا شيء، ١٠)
    اطبع("رمز الحالة: " + نص(استجابة["الحالة"]))
    طول_الصفحة = طول(استجابة["النص"])
    اطبع("طول الصفحة: " + نص(طول_الصفحة) + " حرفًا")
    لو استجابة["الحالة"] == ٢٠٠:
        اطبع("الصفحة وصلت سليمة")
    وإلا:
        اطبع("الخادم رد برمز غير عادي")
باستثناء هـ:
    اطبع("تعذر الاتصال: " + هـ.رسالة)
    اطبع("(قد تكون الشبكة غير متاحة في هذه البيئة)")

# ---- قراءة نص الصفحة مباشرة ----
جرب:
    نص_الصفحة = شبكة.نص_الصفحة("https://example.com")
    لو نص_الصفحة.يحتوي("Example"):
        اطبع("الصفحة تحتوي كلمة Example")
باستثناء هـ:
    اطبع("تم تخطي فحص المحتوى — لا يوجد اتصال")
اخيرا:
    اطبع("انتهى اختبار وحدة شبكة")

# ---- التحقق من صحة المدخلات (يعمل بلا إنترنت) ----
جرب:
    شبكة.اطلب("ftp://رابط-غير-مدعوم")
باستثناء هـ:
    اطبع("رفض الرابط: " + هـ)
