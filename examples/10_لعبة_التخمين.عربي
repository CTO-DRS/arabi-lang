# ============================================
#  لعبة تخمين الرقم — مثال تفاعلي كامل
#  يتطلب إدخالًا من المستخدم أثناء التشغيل
# ============================================

السر = عشوائي(١، ١٠٠)
المحاولات = ٠
الحد_الأقصى = ٧

اطبع("فكرت في رقم بين ١ و ١٠٠")
اطبع("لديك", الحد_الأقصى، "محاولات لتخمنه!")

طالما صح:
    لو المحاولات >= الحد_الأقصى:
        اطبع("انتهت المحاولات! الرقم كان", السر)
        كسر

    جرب:
        المدخل = إدخال("خمن الرقم: ")
        لو المدخل == "":
            اطبع("أُلغيت اللعبة! الرقم كان", السر)
            كسر
        التخمين = عدد(المدخل)
    باستثناء:
        اطبع("أدخل رقما صحيحًا من فضلك!")
        استمر

    المحاولات = المحاولات + ١

    لو التخمين == السر:
        اطبع("أحسنت! خمنت الرقم في", المحاولات، "محاولة")
        كسر
    وإلا إذا التخمين < السر:
        اطبع("الرقم أكبر من تخمينك")
    وإلا:
        اطبع("الرقم أصغر من تخمينك")

اطبع("شكرًا للعب!")
